-- Spawn / Activate
------------------------------------------------------------------------

local function spawnSingleGolemImpl(golemName, preferredSpawnNames)
	local template = getGolemTemplate(golemName)
	if not template then
		return nil
	end

	local spawnFolder = findSpawnFolder()
	local spawnPart, resolvedSpawnName = findSpawnPart(spawnFolder, preferredSpawnNames)
	if not spawnPart then
		warn("[ROOM B ERROR] spawn point NOT FOUND for " .. golemName .. " (tried: " .. table.concat(preferredSpawnNames, ", ") .. ")")
		return nil
	end

	print("[ROOM B GOLEMS] " .. resolvedSpawnName .. " resolved: " .. spawnPart:GetFullName())

	local newGolem = template:Clone()
	newGolem.Name = golemName

	local root = resolveRoot(newGolem)
	if not root then
		warn("[ROOM B ERROR] " .. golemName .. " clone has no BasePart root!")
		newGolem:Destroy()
		return nil
	end

	local container = Workspace:FindFirstChild("TrialChamberActiveGolems")
	if not container then
		container = Instance.new("Folder")
		container.Name = "TrialChamberActiveGolems"
		container.Parent = Workspace
	end

	-- Parent first so GetBoundingBox / PivotTo operate in live Workspace.
	newGolem.Parent = container

	-- Dormant collision / anchoring first so grounding is stable
	applyGolemCollisionSetup(newGolem, root, false)

	local faceDir = Vector3.new(0, 0, -1) -- face toward Room B entrance (south / -Z)
	groundGolemAt(newGolem, root, spawnPart.Position, faceDir)

	newGolem:SetAttribute("IsActive", false)
	newGolem:SetAttribute("AIStarted", false)
	CollectionService:AddTag(newGolem, "Golem")

	ensureAnimator(newGolem)
	preloadGolemAnimations(newGolem, golemName)

	local stats = GOLEM_STATS[golemName] or { MaxHealth = 200 }
	local maxHealth = stats.MaxHealth
	newGolem:SetAttribute("MaxHealth", maxHealth)
	newGolem:SetAttribute("Health", maxHealth)

	createHealthBar(newGolem, root, golemName, maxHealth)

	print("[ROOM B GOLEMS] " .. golemName .. " spawned")
	print("[ROOM B GOLEMS] " .. golemName .. " guard spawned at " .. string.format("%.1f, %.1f, %.1f", root.Position.X, root.Position.Y, root.Position.Z))
	print("[ROOM B DIAGNOSTIC] " .. golemName .. " animation controller initialized")
	print("[ROOM B DIAGNOSTIC] " .. golemName .. " health initialized: " .. tostring(maxHealth) .. "/" .. tostring(maxHealth))
	print("[ROOM B DIAGNOSTIC] " .. golemName .. " health bar initialized")
	print("[ROOM B DIAGNOSTIC] " .. golemName .. " RootPart: FOUND")
	print("[ROOM B DIAGNOSTIC] " .. golemName .. " Humanoid: " .. (newGolem:FindFirstChildOfClass("Humanoid") and "FOUND" or "MISSING"))
	print("[ROOM B DIAGNOSTIC] " .. golemName .. " Animator: " .. ((newGolem:FindFirstChildOfClass("AnimationController") and newGolem:FindFirstChildOfClass("AnimationController"):FindFirstChildOfClass("Animator")) and "FOUND" or "MISSING"))

	return newGolem
end

spawnSingleGolem = spawnSingleGolemImpl

Controller = {}

function Controller.activateGolem(golem, golemType)
	if not golem or not golem.Parent then
		return
	end

	if golem:GetAttribute("AIStarted") == true and golem:GetAttribute("IsActive") == true then
		print("[ROOM B GOLEMS] " .. golemType .. " already active — skipping duplicate activate")
		return
	end

	local root = resolveRoot(golem)
	if not root then
		warn("[ROOM B ERROR] Cannot activate " .. golemType .. " — no root")
		return
	end

	golem:SetAttribute("IsActive", true)
	golem:SetAttribute("AIStarted", true)
	applyGolemCollisionSetup(golem, root, true)
	ensurePlayersInCollisionGroup()

	-- Clear stale offset so we recalibrate after collision/anchor changes
	golem:SetAttribute("GroundPivotOffset", nil)

	-- Re-ground after collision setup so feet sit on floor
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	groundGolemAt(golem, root, root.Position, look, true)

	print("[ROOM B DIAGNOSTIC] " .. golemType .. " movement controller initialized (Anchored root + PivotTo)")

	local animCache = preloadGolemAnimations(golem, golemType)
	print("[ROOM B ANIMATION] " .. golemType .. " Walk = " .. tostring(getConfiguredAnim(golemType, "Walk")))
	print("[ROOM B ANIMATION] " .. golemType .. " Attack = " .. tostring(getConfiguredAnim(golemType, "Attack")))

	spawnController(golem, golemType, animCache)
end

function Controller.spawnGolems()
	print("[ROOM B GOLEMS] === GUARD SETUP ===")
	print("[ROOM B DIAGNOSTIC] Spawning Golems")
	print("[ROOM B GOLEMS] StoneGolem waits until Skeli + Green are defeated")

	invalidateArenaBoundsCache()
	getRoomBArenaBounds()

	-- Reset prior encounter state
	for golemType, conn in pairs(activeConnections) do
		if conn then
			conn:Disconnect()
		end
		activeConnections[golemType] = nil
	end

	local container = Workspace:FindFirstChild("TrialChamberActiveGolems")
	if container then
		for _, child in ipairs(container:GetChildren()) do
			clearGolemAnimCache(child)
			child:Destroy()
		end
	end

	_G.SkeliDefeated = false
	_G.GreenDefeated = false
	_G.StoneDefeated = false
	_G.GateBCOpened = false
	gateBCOpened = false
	stoneEntranceStarted = false
	encounterStarted = true

	local skeli = spawnSingleGolem("SkeliGolem", { "SkeliGuardSpawn", "SkeliSpawn" })
	local green = spawnSingleGolem("GreenGolem", { "GreenGuardSpawn", "GreenSpawn" })

	if skeli and green then
		print("[ROOM B GOLEMS] Both guardians dormant")
	elseif not skeli then
		warn("[ROOM B ERROR] SkeliGolem failed to spawn")
	elseif not green then
		warn("[ROOM B ERROR] GreenGolem failed to spawn")
	end

	-- IMPORTANT: do NOT activate here. Activation happens in ActivateEncounter
	-- after Gate AB fully closes. StoneGolem is NOT pre-spawned.
end

function Controller.StartEncounter()
	print("[ROOM B SYSTEM] TrialChamberGolemController StartEncounter called")
	local ok, err = pcall(function()
		Controller.spawnGolems()
	end)
	if not ok then
		warn("[ROOM B ERROR] StartEncounter/spawnGolems failed: " .. tostring(err))
	end
end

function Controller.ActivateEncounter()
	print("[ROOM B SYSTEM] TrialChamberGolemController ActivateEncounter called")
	print("[ROOM B GOLEMS] === GATE AB CLOSED ===")
	print("[ROOM B GOLEMS] Activating SkeliGolem")

	local ok, err = pcall(function()
		ensurePlayersInCollisionGroup()

		local container = Workspace:FindFirstChild("TrialChamberActiveGolems")
		local skeli = container and container:FindFirstChild("SkeliGolem")
		if skeli then
			Controller.activateGolem(skeli, "SkeliGolem")
		else
			warn("[ROOM B ERROR] Could not find SkeliGolem to activate!")
			-- Recovery: if StartEncounter never ran, spawn then activate
			if not encounterStarted then
				Controller.spawnGolems()
				container = Workspace:FindFirstChild("TrialChamberActiveGolems")
				skeli = container and container:FindFirstChild("SkeliGolem")
				if skeli then
					Controller.activateGolem(skeli, "SkeliGolem")
				end
			end
		end
	end)
	if not ok then
		warn("[ROOM B ERROR] ActivateEncounter failed: " .. tostring(err))
	end
end

_G.TrialChamberGolemController = Controller
_G.GolemController = Controller

task.defer(function()
	local gate = findGateBC()
	if gate and not _G.GateBCOpened then
		local leafL = gate:FindFirstChild("DoorLeaf_L")
		local leafR = gate:FindFirstChild("DoorLeaf_R")
		if leafL and leafR and not _G.GateBCClosedCFrameL then
			_G.GateBCClosedCFrameL = leafL:GetPivot()
			_G.GateBCClosedCFrameR = leafR:GetPivot()
		end
	end
	ensureGateBCCloseWatcher()

	local sss = game:GetService("ServerScriptService")
	for _, name in ipairs({
		"RoomCMoteEncounter",
		"Room_C_Motes",
		"TrialChamberSpellBridge",
		"RoomC_Attack_Spell",
		}) do
		local inst = sss:FindFirstChild(name)
		if inst and inst:IsA("ModuleScript") then
			pcall(require, inst)
		end
	end
end)

return Controller
