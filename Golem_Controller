local function beginStoneSkyDropEntranceImpl()
	if stoneEntranceStarted then
		return
	end
	stoneEntranceStarted = true

	print("[ROOM B GOLEMS] === STONE ENTRANCE ===")
	print("[ROOM B GOLEMS] Preparing StoneGolem sky-drop")

	if not Controller then
		warn("[ROOM B ERROR] Controller missing for Stone entrance")
		return
	end

	local landing = getStoneLandingPosition()
	local stone = spawnSingleGolem("StoneGolem", { "StoneGuardSpawn", "StoneSpawn", "SkeliGuardSpawn" })
	if not stone then
		warn("[ROOM B ERROR] StoneGolem failed to spawn for sky-drop!")
		_G.StoneDefeated = true -- avoid soft-lock if template missing
		checkRoomBCompletion()
		return
	end

	local root = resolveRoot(stone)
	if not root then
		stone:Destroy()
		_G.StoneDefeated = true
		checkRoomBCompletion()
		return
	end

	-- Keep dormant/immovable during the fall.
	stone:SetAttribute("IsActive", false)
	stone:SetAttribute("AIStarted", false)
	applyGolemCollisionSetup(stone, root, false)

	-- Place high above landing, then deterministically lower onto the floor.
	local faceDir = Vector3.new(0, 0, -1)
	local bounds = getRoomBArenaBounds()
	local landingFloorY = bounds and bounds.floorY or landing.Y
	local startPos = Vector3.new(landing.X, landingFloorY + STONE_DROP_HEIGHT, landing.Z)
	stone:PivotTo(CFrame.lookAt(startPos, startPos + faceDir))

	print("[ROOM B GOLEMS] StoneGolem sky-drop started")

	local elapsed = 0
	local dropConn
	dropConn = RunService.Heartbeat:Connect(function(dt)
		if not stone.Parent then
			dropConn:Disconnect()
			return
		end

		elapsed += dt
		local alpha = math.clamp(elapsed / STONE_DROP_DURATION, 0, 1)
		-- Ease-in for a heavy smash feel
		local eased = alpha * alpha
		local y = startPos.Y + (landingFloorY - startPos.Y) * eased
		local pos = Vector3.new(landing.X, y, landing.Z)
		stone:PivotTo(CFrame.lookAt(pos, pos + faceDir))

		if alpha >= 1 then
			dropConn:Disconnect()
			stone:SetAttribute("GroundPivotOffset", nil)
			lockArenaFloorY(stone, landingFloorY)
			groundGolemAt(stone, root, landing, faceDir, true)
			local pivotToBottom = getPivotToBottomOffset(stone)
			playStoneImpactEffect(stone:GetPivot().Position - Vector3.new(0, pivotToBottom, 0))
			print("[ROOM B GOLEMS] StoneGolem impact")
			print("[ROOM B GOLEMS] Activating StoneGolem")
			task.delay(0.35, function()
				if stone.Parent and Controller.activateGolem then
					Controller.activateGolem(stone, "StoneGolem")
				end
			end)
		end
	end)
end

beginStoneSkyDropEntrance = beginStoneSkyDropEntranceImpl

