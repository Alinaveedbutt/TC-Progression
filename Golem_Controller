local function openGateBC()
	if gateBCOpened or _G.GateBCOpened then
		return
	end
	gateBCOpened = true
	_G.GateBCOpened = true

	print("[ROOM B GOLEMS] All guardians defeated")
	print("[ROOM B GOLEMS] Gate BC may open")

	local gateBC = findGateBC()
	if not gateBC then
		warn("[ROOM B ERROR] Gate_BC not found for opening!")
		return
	end

	local leafL = gateBC:FindFirstChild("DoorLeaf_L")
	local leafR = gateBC:FindFirstChild("DoorLeaf_R")
	if not leafL or not leafR then
		warn("[ROOM B ERROR] Gate_BC door leaves not found!")
		return
	end

	-- Remember sealed pose for Revamp's close-on-Room-C-entry (if not already stored).
	if not _G.GateBCClosedCFrameL then
		_G.GateBCClosedCFrameL = leafL:GetPivot()
		_G.GateBCClosedCFrameR = leafR:GetPivot()
	end

	print("[ROOM B] Gate BC opened successfully")
	print("[RoomB] ALL GOLEMS DEFEATED. OPENING GATE BC.")

	local startL = leafL:GetPivot()
	local startR = leafR:GetPivot()
	local targetL = CFrame.new(startL.Position + Vector3.new(-14, 0, 0)) * startL.Rotation
	local targetR = CFrame.new(startR.Position + Vector3.new(14, 0, 0)) * startR.Rotation
	local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

	local cframeValL = Instance.new("CFrameValue")
	cframeValL.Value = startL
	cframeValL.Changed:Connect(function()
		leafL:PivotTo(cframeValL.Value)
	end)

	local cframeValR = Instance.new("CFrameValue")
	cframeValR.Value = startR
	cframeValR.Changed:Connect(function()
		leafR:PivotTo(cframeValR.Value)
	end)

	TweenService:Create(cframeValL, tweenInfo, { Value = targetL }):Play()
	TweenService:Create(cframeValR, tweenInfo, { Value = targetR }):Play()

	ensureGateBCCloseWatcher()
end

local gateBCCloseConn = nil
local gateBCClosing = false

local function playerCrossedGateBC(rootPart, leafL)
	if not rootPart or not leafL then
		return false
	end
	local gatePos = leafL:GetPivot().Position
	-- Same rule as Gate_AB: 12 studs past the door.
	if rootPart.Position.Z > gatePos.Z + 12 then
		return true
	end
	local chamber = Workspace:FindFirstChild("TrialChamberGeneratedV5_Sky")
		or Workspace:FindFirstChild("TrialChamberActive")
		or Workspace:FindFirstChild("TrialChamberV2")
	if chamber then
		local pivot = chamber:GetPivot()
		local playerZ = pivot:PointToObjectSpace(rootPart.Position).Z
		local gateZ = pivot:PointToObjectSpace(gatePos).Z
		if playerZ > gateZ + 12 then
			return true
		end
	end
	return false
end

local function closeGateBCFromThreshold()
	if gateBCClosing or _G.GateBCSealed then
		return
	end
	if not (gateBCOpened or _G.GateBCOpened) then
		return
	end

	local gateBC = findGateBC()
	if not gateBC then
		return
	end
	local leafL = gateBC:FindFirstChild("DoorLeaf_L")
	local leafR = gateBC:FindFirstChild("DoorLeaf_R")
	if not leafL or not leafR then
		return
	end

	local closedL = _G.GateBCClosedCFrameL
	local closedR = _G.GateBCClosedCFrameR
	if not closedL or not closedR then
		warn("[ROOM B] Gate BC close skipped — closed pose missing")
		return
	end

	gateBCClosing = true
	_G.GateBCSealed = true
	print("[RoomC] PLAYER CROSSED GATE_BC THRESHOLD — closing and locking")

	local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
	local cframeValL = Instance.new("CFrameValue")
	cframeValL.Value = leafL:GetPivot()
	cframeValL.Changed:Connect(function()
		leafL:PivotTo(cframeValL.Value)
	end)
	local cframeValR = Instance.new("CFrameValue")
	cframeValR.Value = leafR:GetPivot()
	cframeValR.Changed:Connect(function()
		leafR:PivotTo(cframeValR.Value)
	end)
	local tweenL = TweenService:Create(cframeValL, tweenInfo, { Value = closedL })
	tweenL.Completed:Connect(function()
		print("[RoomC] GATE_BC sealed")
	end)
	tweenL:Play()
	TweenService:Create(cframeValR, tweenInfo, { Value = closedR }):Play()
end

ensureGateBCCloseWatcher = function()
	if gateBCCloseConn then
		return
	end
	gateBCCloseConn = RunService.Heartbeat:Connect(function()
		if _G.GateBCSealed then
			if gateBCCloseConn then
				gateBCCloseConn:Disconnect()
				gateBCCloseConn = nil
			end
			return
		end
		if not (gateBCOpened or _G.GateBCOpened) then
			return
		end

		local gateBC = findGateBC()
		local leafL = gateBC and gateBC:FindFirstChild("DoorLeaf_L")
		if not leafL then
			return
		end

		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if rootPart and playerCrossedGateBC(rootPart, leafL) then
				closeGateBCFromThreshold()
				if _G.TrialChamberRespawn and _G.TrialChamberRespawn.setCheckpoint then
					_G.TrialChamberRespawn.setCheckpoint(player, "C")
				else
					player:SetAttribute("CurrentTrialRoom", "C")
				end
				if _G.TrialSpell and type(_G.TrialSpell.unlockSpell) == "function" then
					_G.TrialSpell.unlockSpell(player)
				end
				if _G.TrialSpell and type(_G.TrialSpell.orderHotbar) == "function" then
					_G.TrialSpell.orderHotbar(player)
				end
				break
			end
		end
	end)
end

local function checkRoomBCompletion()
	if _G.SkeliDefeated and _G.GreenDefeated and _G.StoneDefeated then
		openGateBC()
	end
end

local function getStoneLandingPosition()
	local spawnFolder = findSpawnFolder()
	local skeliSpawn = spawnFolder and (spawnFolder:FindFirstChild("SkeliGuardSpawn") or spawnFolder:FindFirstChild("SkeliSpawn"))
	local greenSpawn = spawnFolder and (spawnFolder:FindFirstChild("GreenGuardSpawn") or spawnFolder:FindFirstChild("GreenSpawn"))
	local stoneSpawn = spawnFolder and (spawnFolder:FindFirstChild("StoneGuardSpawn") or spawnFolder:FindFirstChild("StoneSpawn"))

	if stoneSpawn then
		return clampToArenaXZ(stoneSpawn.Position)
	end
	if skeliSpawn and greenSpawn then
		return clampToArenaXZ((skeliSpawn.Position + greenSpawn.Position) * 0.5)
	end
	if skeliSpawn then
		return clampToArenaXZ(skeliSpawn.Position)
	end

	local roomB = findRoomB()
	if roomB then
		local gate = findGateBC()
		if gate then
			local gatePos = gate:GetPivot().Position
			return Vector3.new(gatePos.X, gatePos.Y, gatePos.Z - 18)
		end
	end

	return Vector3.new(0, 120, 350)
end

