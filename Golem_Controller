local function spawnController(golem, golemType, animCache)
	local root = resolveRoot(golem)
	if not root then
		warn("[ROOM B ERROR] " .. golemType .. " has no root part!")
		return
	end

	if not animCache then
		animCache = preloadGolemAnimations(golem, golemType)
	end

	local currentState = "Chasing"
	local targetPlayer = nil
	local lastAttackTime = 0
	local timeSinceLastUpdate = 0
	local attackInProgress = false
	local isDying = false
	local animCtrl = createGolemAnimController(golemType, animCache)

	animCtrl.request("Walk")

	local function setAIState(newState)
		if isDying or animCtrl.isLocked() then
			return
		end
		if currentState == newState then
			return
		end
		currentState = newState
		print("[ROOM B AI] " .. golemType .. " -> " .. string.upper(newState))

		if newState == "Idle" then
			animCtrl.request("Idle")
		elseif newState == "Chasing" then
			animCtrl.request("Walk")
		elseif newState == "Attacking" then
			animCtrl.request("Attack")
		end
	end

	local function beginDeathSequence()
		if isDying then
			return
		end
		isDying = true
		currentState = "Dying"
		golem:SetAttribute("IsActive", false)
		golem:SetAttribute("AIStarted", false)
		print("[ROOM B AI] " .. golemType .. " -> DYING")
		print("[ROOM B COMBAT] " .. golemType .. " defeated")
		print("[ROOM B GOLEMS] " .. golemType .. " defeated")

		clearConnection(golemType)

		task.spawn(function()
			local track = animCtrl.request("Death")
			if track then
				waitForDeathAnimation(track)
				-- Hold the last death frame so the body stays down instead of snapping back.
				pcall(function()
					if track.Length and track.Length > 0 then
						track:Play(0)
						track.TimePosition = math.max(0, track.Length - 0.05)
					end
					track:AdjustSpeed(0)
				end)
			end
			clearGolemAnimCache(golem)
			currentState = "Dead"

			if golemType == "SkeliGolem" then
				_G.SkeliDefeated = true
				print("[ROOM B GOLEMS] Activating existing GreenGolem")
				local container = Workspace:FindFirstChild("TrialChamberActiveGolems")
				local green = container and container:FindFirstChild("GreenGolem")
				if green then
					task.delay(0.75, function()
						if green.Parent and Controller and Controller.activateGolem then
							Controller.activateGolem(green, "GreenGolem")
						end
					end)
				else
					warn("[ROOM B ERROR] GreenGolem missing after Skeli defeat!")
				end
			elseif golemType == "GreenGolem" then
				_G.GreenDefeated = true
				print("[ROOM B GOLEMS] GreenGolem defeated — scheduling StoneGolem entrance")
				task.delay(1.0, function()
					beginStoneSkyDropEntrance()
				end)
			elseif golemType == "StoneGolem" then
				_G.StoneDefeated = true
				print("[PROGRESSION] StoneGolem defeated")
				print("[ROOM B GOLEMS] StoneGolem defeated")
				-- Spell unlocks on Room C entry (Gate_BC close), not here in Room B.
				checkRoomBCompletion()
			end

			-- Leave the body on the floor. Freeze collision/anchors in the death pose.
			if golem and golem.Parent then
				golem:SetAttribute("IsCorpse", true)
				golem:SetAttribute("IsActive", false)
				local corpseRoot = resolveRoot(golem)
				if corpseRoot then
					applyGolemCollisionSetup(golem, corpseRoot, false)
					local bar = corpseRoot:FindFirstChild("HealthBar")
					if bar then
						bar:Destroy()
					end
				end
				print("[ROOM B GOLEMS] " .. golemType .. " corpse left in place")
			end
		end)
	end

	local function getNearestPlayer(position, maxDistance)
		local nearest = nil
		local shortest = maxDistance
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			if character then
				applyPlayerCollisionGroup(character)
				local hum = character:FindFirstChildOfClass("Humanoid")
				local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
				if hum and hum.Health > 0 and rootPart then
					local dist = (rootPart.Position - position).Magnitude
					if dist < shortest then
						shortest = dist
						nearest = player
					end
				end
			end
		end
		return nearest
	end

	local activeConn
	activeConn = RunService.Heartbeat:Connect(function(dt)
		if not golem.Parent then
			activeConn:Disconnect()
			return
		end

		if golem:GetAttribute("IsActive") ~= true then
			return
		end

		local currentHealth = golem:GetAttribute("Health") or 0
		if currentHealth <= 0 then
			beginDeathSequence()
			return
		end

		if isDying or currentState == "Dying" or currentState == "Dead" then
			return
		end

		-- Target acquisition
		local targetStillValid = false
		if targetPlayer and targetPlayer.Character then
			local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
			local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character.PrimaryPart
			targetStillValid = hum and hum.Health > 0 and tRoot ~= nil
		end

		if not targetStillValid then
			local newTarget = getNearestPlayer(root.Position, 1000)
			if newTarget ~= targetPlayer then
				targetPlayer = newTarget
				if targetPlayer then
					print("[ROOM B GOLEMS] " .. golemType .. " target acquired: " .. targetPlayer.Name)
					if currentState == "Idle" then
						setAIState("Chasing")
					end
				elseif currentState ~= "Attacking" then
					setAIState("Idle")
				end
			end
		end

		-- Immediate target on first frames — don't wait for target swap event.
		if not targetPlayer then
			targetPlayer = getNearestPlayer(root.Position, 1000)
			if targetPlayer and currentState == "Idle" then
				setAIState("Chasing")
			end
		end

		local targetRoot = targetPlayer
			and targetPlayer.Character
			and (targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character.PrimaryPart)

		if not targetRoot then
			return
		end

		local diff = targetRoot.Position - root.Position
		local flatDiff = Vector3.new(diff.X, 0, diff.Z)
		local dist = flatDiff.Magnitude
		local flatDir = (dist > 0.001) and flatDiff.Unit or Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if flatDir.Magnitude < 0.001 then
			flatDir = Vector3.new(0, 0, -1)
		else
			flatDir = flatDir.Unit
		end

		if currentState == "Idle" or currentState == "Chasing" then
			if dist <= ATTACK_RANGE then
				if not attackInProgress and tick() - lastAttackTime >= ATTACK_COOLDOWN then
					attackInProgress = true
					setAIState("Attacking")
					print("[ROOM B COMBAT] " .. golemType .. " attack started")

					task.spawn(function()
						local attackHitFraction = getAttackHitFraction(golemType)
						local track = animCache.attack
						local trackLength = waitForTrackLength(track, 0.5)

						local damageDelay = trackLength * attackHitFraction
						task.wait(damageDelay)

						if not isDying and golem.Parent and golem:GetAttribute("IsActive") and targetPlayer and targetPlayer.Character then
							local targetHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
							local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
								or targetPlayer.Character.PrimaryPart
							if targetHum and targetHum.Health > 0 and tRoot then
								local currentDist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(tRoot.Position.X, 0, tRoot.Position.Z)).Magnitude
								if currentDist <= ATTACK_RANGE + 2 then
									targetHum:TakeDamage(PLAYER_ATTACK_DAMAGE)
									print("[ROOM B COMBAT] " .. golemType .. " attack damage applied")
									print("[ROOM B COMBAT] " .. golemType .. " attack HIT player (" .. PLAYER_ATTACK_DAMAGE .. " dmg)")
								else
									print("[ROOM B COMBAT] " .. golemType .. " attack MISSED player (distance: " .. string.format("%.1f", currentDist) .. ")")
								end
							end
						end

						task.wait(ATTACK_WINDDOWN_AFTER_HIT)

						attackInProgress = false
						lastAttackTime = tick()

						if not isDying and golem.Parent and golem:GetAttribute("IsActive") then
							currentState = "Chasing"
							animCtrl.request("Walk")
						end
					end)
				end
			else
				setAIState("Chasing")
			end

			if currentState == "Chasing" then
				timeSinceLastUpdate += dt
				if timeSinceLastUpdate >= MOVE_INTERVAL then
					timeSinceLastUpdate = 0

					local stepDist = WALK_SPEED * MOVE_INTERVAL
					local nextPos = root.Position + flatDir * stepDist
					groundGolemAt(golem, root, nextPos, flatDir, false)

					if math.random() < 0.08 then
						local lockedY = getLockedArenaFloorY(golem) or root.Position.Y
						print("[ROOM B MOVEMENT] " .. golemType .. " physically moving")
						print("[ROOM B MOVEMENT] current position: " .. string.format("%.1f, %.1f, %.1f", root.Position.X, lockedY, root.Position.Z))
						print("[ROOM B MOVEMENT] Target position: " .. string.format("%.1f, %.1f, %.1f", targetRoot.Position.X, targetRoot.Position.Y, targetRoot.Position.Z))
						print("[ROOM B MOVEMENT] Distance: " .. string.format("%.1f", dist))
					end
				end
			end
		elseif currentState == "Attacking" then
			timeSinceLastUpdate += dt
			if timeSinceLastUpdate >= MOVE_INTERVAL then
				timeSinceLastUpdate = 0
				-- Face player but stay on locked floor — no vertical follow
				groundGolemAt(golem, root, root.Position, flatDir, false)
			end
		end
	end)

	trackConnection(golemType, activeConn)
end

