local function findTrialRoot()
	return Workspace:FindFirstChild("TrialChamberGeneratedV5_Sky")
		or Workspace:FindFirstChild("TrialChamberActive")
		or Workspace:FindFirstChild("TrialChamberV2")
end

local function findRoomB()
	local root = findTrialRoot()
	return root and root:FindFirstChild("RoomB") or nil
end

local function findGateBC()
	local roomB = findRoomB()
	if not roomB then
		return nil
	end
	local decorations = roomB:FindFirstChild("Decorations")
	if decorations then
		local gate = decorations:FindFirstChild("Gate_BC")
		if gate then
			return gate
		end
	end
	return roomB:FindFirstChild("Gate_BC", true)
end

local function findSpawnFolder()
	local roomB = findRoomB()
	if roomB then
		local spawnFolder = roomB:FindFirstChild("GolemSpawnPoints")
		if spawnFolder then
			return spawnFolder
		end
	end
	return Workspace:FindFirstChild("GolemSpawnPoints", true)
end

local function findSpawnPart(spawnFolder, preferredNames)
	if not spawnFolder then
		return nil
	end
	for _, name in ipairs(preferredNames) do
		local part = spawnFolder:FindFirstChild(name)
		if part then
			return part, name
		end
	end
	return nil, nil
end

local function deepFindModel(container, modelName)
	if not container then
		return nil
	end
	local direct = container:FindFirstChild(modelName)
	if direct and direct:IsA("Model") then
		return direct
	end
	for _, desc in ipairs(container:GetDescendants()) do
		if desc.Name == modelName and desc:IsA("Model") then
			return desc
		end
	end
	return nil
end

local function isUsableTemplate(template)
	if not template or not template:IsA("Model") then
		return false
	end
	if template:GetAttribute("IsActive") then
		return false
	end
	if CollectionService:HasTag(template, "Golem") then
		return false
	end
	-- Reject live spawned copies sitting in the active golem container
	if template.Parent and template.Parent.Name == "TrialChamberActiveGolems" then
		return false
	end
	return true
end

local function getGolemTemplate(golemName)
	local ServerStorage = game:GetService("ServerStorage")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local preferredFolders = {
		ServerStorage:FindFirstChild("TrialChamberGolems"),
		ServerStorage:FindFirstChild("Enemies"),
		ServerStorage:FindFirstChild("Golems"),
		ReplicatedStorage:FindFirstChild("TrialChamberGolems"),
		ReplicatedStorage:FindFirstChild("Enemies"),
	}

	for _, folder in ipairs(preferredFolders) do
		if folder then
			local template = folder:FindFirstChild(golemName)
			if isUsableTemplate(template) then
				print("[ROOM B GOLEMS] " .. golemName .. " template resolved: " .. template:GetFullName())
				return template
			end
		end
	end

	local deepSources = { ServerStorage, ReplicatedStorage }
	for _, storage in ipairs(deepSources) do
		local template = deepFindModel(storage, golemName)
		if isUsableTemplate(template) then
			print("[ROOM B GOLEMS] " .. golemName .. " template resolved: " .. template:GetFullName())
			return template
		end
	end

	-- Workspace fallback (careful — only untagged templates)
	local workspaceHit = deepFindModel(Workspace, golemName)
	if isUsableTemplate(workspaceHit) then
		print("[ROOM B GOLEMS] " .. golemName .. " template resolved: " .. workspaceHit:GetFullName())
		return workspaceHit
	end

	warn("[ROOM B ERROR] " .. golemName .. " template NOT FOUND in standard paths!")
	return nil
end

local function ensureAnimator(golem)
	local animController = golem:FindFirstChildOfClass("AnimationController")
	if not animController then
		animController = Instance.new("AnimationController")
		animController.Name = "AnimationController"
		animController.Parent = golem
	end

	local animator = animController:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Name = "Animator"
		animator.Parent = animController
	end

	return animController, animator
end

local function clearGolemAnimCache(golem)
	golemAnimCaches[golem] = nil
end

-- MUST be defined before preloadGolemAnimations (local functions are not hoisted).
local function getConfiguredAnim(golemType, kind)
	local cfg = GOLEM_ANIMS[golemType]
	if not cfg then
		return nil
	end
	return cfg[kind]
end

local function getAttackHitFraction(golemType)
	local cfg = GOLEM_ANIMS[golemType]
	if cfg and typeof(cfg.AttackHitTime) == "number" then
		return cfg.AttackHitTime
	end
	return DEFAULT_ATTACK_HIT_FRACTION
end

local function waitForTrackLength(track, maxWait)
	if not track then
		return 1.0
	end
	if track.Length > 0 then
		return track.Length
	end
	local waited = 0
	local limit = maxWait or 1.0
	while track.Length == 0 and waited < limit do
		waited += task.wait(0.03)
	end
	return track.Length > 0 and track.Length or 1.0
end

-- Preload walk + attack once per golem so activation/combat never waits on LoadAnimation.
local function preloadGolemAnimations(golem, golemType)
	local existing = golemAnimCaches[golem]
	if existing then
		return existing
	end

	local animator = select(2, ensureAnimator(golem))
	local cache = {
		golemType = golemType,
		walk = nil,
		attack = nil,
		death = nil,
	}

	local walkId = getConfiguredAnim(golemType, "Walk")
	local attackId = getConfiguredAnim(golemType, "Attack")
	local deathId = getConfiguredAnim(golemType, "Death")

	if walkId then
		local ok, track = pcall(function()
			local anim = Instance.new("Animation")
			anim.Name = "GolemWalkAnim"
			anim.AnimationId = walkId
			local loaded = animator:LoadAnimation(anim)
			loaded.Priority = Enum.AnimationPriority.Movement
			loaded.Looped = true
			return loaded
		end)
		if ok then
			cache.walk = track
		end
	end

	if attackId then
		local ok, track = pcall(function()
			local anim = Instance.new("Animation")
			anim.Name = "GolemAttackAnim"
			anim.AnimationId = attackId
			local loaded = animator:LoadAnimation(anim)
			loaded.Priority = Enum.AnimationPriority.Action
			loaded.Looped = false
			return loaded
		end)
		if ok then
			cache.attack = track
		end
	end

	if deathId then
		local ok, track = pcall(function()
			local anim = Instance.new("Animation")
			anim.Name = "GolemDeathAnim"
			anim.AnimationId = deathId
			local loaded = animator:LoadAnimation(anim)
			loaded.Priority = Enum.AnimationPriority.Action4
			loaded.Looped = false
			return loaded
		end)
		if ok then
			cache.death = track
		end
	end

	golemAnimCaches[golem] = cache

	-- Warm lengths in background while dormant.
	task.spawn(function()
		waitForTrackLength(cache.walk, 2.0)
		waitForTrackLength(cache.attack, 2.0)
		waitForTrackLength(cache.death, 2.0)
	end)

	return cache
end

-- Single authoritative animation state machine per golem.
local function createGolemAnimController(golemType, animCache)
	local animState = "None"
	local locked = false

	local function stateLabel(state)
		if state == "None" then
			return "IDLE"
		end
		return string.upper(state)
	end

	local function logTransition(fromState, toState)
		print(string.format("[ROOM B ANIMATION] %s: %s -> %s", golemType, stateLabel(fromState), stateLabel(toState)))
	end

	local function requestAnimState(state)
		if locked then
			return animCache.death
		end
		if animState == state then
			-- Allow a new attack swing once the prior attack track has finished.
			if state == "Attack" and animCache.attack and not animCache.attack.IsPlaying then
				animCache.attack:Play(ANIM_FADE_WALK_ATTACK)
			end
			return nil
		end

		local prev = animState

		if state == "Death" then
			locked = true
			local fade = ANIM_FADE_DEATH
			if animCache.attack and animCache.attack.IsPlaying then
				pcall(function()
					animCache.attack:Stop(fade)
				end)
			end
			if animCache.walk and animCache.walk.IsPlaying then
				pcall(function()
					animCache.walk:Stop(fade)
				end)
			end
			if animCache.death and not animCache.death.IsPlaying then
				animCache.death:Play(fade)
			end
			print(string.format("[ROOM B ANIMATION] %s: -> DYING", golemType))
			animState = "Death"
			return animCache.death
		end

		if state == "Idle" then
			local fade = ANIM_FADE_WALK_IDLE
			if prev == "Attack" and animCache.attack and animCache.attack.IsPlaying then
				pcall(function()
					animCache.attack:Stop(ANIM_FADE_ATTACK_WALK)
				end)
			end
			if animCache.walk and animCache.walk.IsPlaying then
				pcall(function()
					animCache.walk:Stop(fade)
				end)
			end
		elseif state == "Walk" then
			local fade = ANIM_FADE_ATTACK_WALK
			if prev == "Attack" and animCache.attack and animCache.attack.IsPlaying then
				pcall(function()
					animCache.attack:Stop(fade)
				end)
			elseif prev == "Idle" or prev == "None" then
				fade = ANIM_FADE_IDLE_WALK
			end
			if animCache.walk and not animCache.walk.IsPlaying then
				animCache.walk:Play(fade)
			end
		elseif state == "Attack" then
			local fade = ANIM_FADE_WALK_ATTACK
			-- Keep walk running underneath; Action priority overrides Movement.
			if animCache.walk and not animCache.walk.IsPlaying then
				animCache.walk:Play(ANIM_FADE_IDLE_WALK)
			end
			if animCache.attack and not animCache.attack.IsPlaying then
				animCache.attack:Play(fade)
			end
		end

		logTransition(prev, state)
		animState = state
		return nil
	end

	return {
		request = requestAnimState,
		isLocked = function()
			return locked
		end,
	}
end

local function waitForDeathAnimation(track)
	if not track then
		return
	end
	if track.IsPlaying then
		track.Ended:Wait()
		return
	end
	local length = waitForTrackLength(track, 2.0)
	if length > 0 then
		task.wait(length)
	end
end

local function invalidateArenaBoundsCache()
	cachedArenaBounds = nil
end

local function getRoomBArenaBounds()
	if cachedArenaBounds then
		return cachedArenaBounds
	end

	local roomB = findRoomB()
	if not roomB then
		return nil
	end

	local floorMain = nil
	for _, desc in ipairs(roomB:GetDescendants()) do
		if desc:IsA("BasePart") and (desc.Name == "Floor_Main" or desc.Name == "Walkway_South" or desc.Name == "Walkway_North") then
			floorMain = desc
			if desc.Name == "Floor_Main" then
				break
			end
		end
	end

	if floorMain then
		local cf = floorMain.CFrame
		local size = floorMain.Size
		local topY = cf.Position.Y + (size.Y * 0.5)
		cachedArenaBounds = {
			minX = cf.Position.X - (size.X * 0.5) + ARENA_WALL_MARGIN,
			maxX = cf.Position.X + (size.X * 0.5) - ARENA_WALL_MARGIN,
			minZ = cf.Position.Z - (size.Z * 0.5) + ARENA_WALL_MARGIN,
			maxZ = cf.Position.Z + (size.Z * 0.5) - ARENA_WALL_MARGIN,
			floorY = topY,
			maxFloorY = topY + 1.5,
		}
		print("[ROOM B GOLEMS] Arena bounds from " .. floorMain.Name .. " floorY=" .. string.format("%.1f", topY))
		return cachedArenaBounds
	end

	local cf, size = roomB:GetBoundingBox()
	cachedArenaBounds = {
		minX = cf.Position.X - (size.X * 0.5) + ARENA_WALL_MARGIN,
		maxX = cf.Position.X + (size.X * 0.5) - ARENA_WALL_MARGIN,
		minZ = cf.Position.Z - (size.Z * 0.5) + ARENA_WALL_MARGIN,
		maxZ = cf.Position.Z + (size.Z * 0.5) - ARENA_WALL_MARGIN,
		floorY = cf.Position.Y - (size.Y * 0.5) + 8,
		maxFloorY = cf.Position.Y - (size.Y * 0.5) + 12,
	}
	print("[ROOM B GOLEMS] Arena bounds from RoomB bbox floorY=" .. string.format("%.1f", cachedArenaBounds.floorY))
	return cachedArenaBounds
end

local function clampToArenaXZ(position)
	local bounds = getRoomBArenaBounds()
	if not bounds then
		return position
	end
	return Vector3.new(
		math.clamp(position.X, bounds.minX, bounds.maxX),
		position.Y,
		math.clamp(position.Z, bounds.minZ, bounds.maxZ)
	)
end

local function isRejectedFloorPart(part)
	if not part or not part:IsA("BasePart") then
		return true
	end

	local name = string.lower(part.Name)
	if string.find(name, "roof", 1, true)
		or string.find(name, "beam", 1, true)
		or string.find(name, "chain", 1, true)
		or string.find(name, "banner", 1, true)
		or string.find(name, "torch", 1, true)
		or string.find(name, "pedestal", 1, true) then
		return true
	end

	local ancestor = part.Parent
	while ancestor do
		local ancestorName = string.lower(ancestor.Name)
		if string.find(ancestorName, "roof", 1, true)
			or string.find(ancestorName, "partialroof", 1, true) then
			return true
		end
		if ancestor == findRoomB() then
			break
		end
		ancestor = ancestor.Parent
	end

	return false
end

local function isPreferredArenaFloorPart(part)
	if isRejectedFloorPart(part) then
		return false
	end

	local name = string.lower(part.Name)
	if string.find(name, "floor", 1, true)
		or string.find(name, "walkway", 1, true)
		or string.find(name, "threshold", 1, true)
		or string.find(name, "ground", 1, true)
		or string.find(name, "cobblestone", 1, true) then
		return true
	end

	return part.Size.Y <= 2.5 and (part.Size.X * part.Size.Z) >= 36
end

local function resolveRoot(golem)
	local root = golem.PrimaryPart
		or golem:FindFirstChild("char1")
		or golem:FindFirstChild("HumanoidRootPart")
		or golem:FindFirstChild("RootPart")
		or golem:FindFirstChild("Torso")

	if not root then
		for _, part in ipairs(golem:GetDescendants()) do
			if part:IsA("BasePart") then
				root = part
				break
			end
		end
	end

	if root and golem.PrimaryPart ~= root then
		golem.PrimaryPart = root
	end

	return root
end

-- PivotTo moves the MODEL PIVOT, not necessarily PrimaryPart/root.
-- Prior bug: offset was computed from root.Position, then applied via PivotTo,
-- which left feet ~1 character-height above the floor when pivot ≠ root.
local function getPivotToBottomOffset(golem)
	local cached = golem:GetAttribute("GroundPivotOffset")
	if typeof(cached) == "number" then
		return cached
	end

	local pivotPos = golem:GetPivot().Position
	local bboxCF, bboxSize = golem:GetBoundingBox()
	local bottomY = bboxCF.Position.Y - (bboxSize.Y / 2)
	return pivotPos.Y - bottomY
end

local function calibrateGroundOffset(golem)
	-- Measure while fully posed/anchored (or just after landing), then lock it
	-- so walk animations cannot change vertical placement every frame.
	local pivotPos = golem:GetPivot().Position
	local bboxCF, bboxSize = golem:GetBoundingBox()
	local bottomY = bboxCF.Position.Y - (bboxSize.Y / 2)
	local offset = pivotPos.Y - bottomY
	golem:SetAttribute("GroundPivotOffset", offset)
	return offset
end

local function raycastArenaFloor(golem, horizontalPos, maxFloorY)
	local bounds = getRoomBArenaBounds()
	local ceilingY = maxFloorY
	if typeof(ceilingY) ~= "number" then
		ceilingY = bounds and bounds.maxFloorY or (horizontalPos.Y + 2)
	end

	local exclude = {
		golem,
		Workspace:FindFirstChild("TrialChamberActiveGolems"),
		findSpawnFolder(),
	}

	local originY = ceilingY + 30
	local origin = Vector3.new(horizontalPos.X, originY, horizontalPos.Z)
	local direction = Vector3.new(0, -120, 0)

	local bestPreferred = nil
	local bestFallback = nil

	for _ = 1, 12 do
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = exclude
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local result = Workspace:Raycast(origin, direction, rayParams)
		if not result then
			break
		end

		local part = result.Instance
		local hitY = result.Position.Y

		if hitY <= ceilingY and result.Normal.Y >= 0.45 and not isRejectedFloorPart(part) then
			if isPreferredArenaFloorPart(part) then
				bestPreferred = hitY
				break
			elseif not bestFallback then
				bestFallback = hitY
			end
		end

		table.insert(exclude, part)
		origin = result.Position + Vector3.new(0, -0.05, 0)
		direction = Vector3.new(0, -(origin.Y + 40), 0)
	end

	if bestPreferred then
		return bestPreferred
	end
	if bestFallback then
		return bestFallback
	end
	if bounds and bounds.floorY then
		return bounds.floorY
	end
	return horizontalPos.Y - 5
end

local function lockArenaFloorY(golem, floorY)
	golem:SetAttribute("ArenaFloorY", floorY)
end

local function getLockedArenaFloorY(golem)
	local locked = golem:GetAttribute("ArenaFloorY")
	if typeof(locked) == "number" then
		return locked
	end
	return nil
end

local function pivotGolemAtFloor(golem, horizontalPos, lookFlatDir, floorY)
	local flatLook = lookFlatDir
	if typeof(flatLook) ~= "Vector3" or flatLook.Magnitude < 0.001 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = Vector3.new(flatLook.X, 0, flatLook.Z).Unit
	end

	local clampedXZ = clampToArenaXZ(horizontalPos)
	local pivotToBottom = getPivotToBottomOffset(golem)
	local targetPivotY = floorY + pivotToBottom
	local groundedPos = Vector3.new(clampedXZ.X, targetPivotY, clampedXZ.Z)
	local lookTarget = groundedPos + flatLook
	golem:PivotTo(CFrame.lookAt(groundedPos, Vector3.new(lookTarget.X, groundedPos.Y, lookTarget.Z)))
end

local function groundGolemAt(golem, root, horizontalPos, lookFlatDir, forceRecalibrate)
	local bounds = getRoomBArenaBounds()
	local maxFloorY = bounds and bounds.maxFloorY or nil

	local floorY
	if forceRecalibrate then
		golem:SetAttribute("GroundPivotOffset", nil)
		if bounds and bounds.floorY then
			floorY = bounds.floorY
		else
			floorY = raycastArenaFloor(golem, horizontalPos, maxFloorY)
		end
		lockArenaFloorY(golem, floorY)
	else
		floorY = getLockedArenaFloorY(golem)
		if typeof(floorY) ~= "number" then
			if bounds and bounds.floorY then
				floorY = bounds.floorY
			else
				floorY = raycastArenaFloor(golem, horizontalPos, maxFloorY)
			end
			lockArenaFloorY(golem, floorY)
		end
	end

	pivotGolemAtFloor(golem, horizontalPos, lookFlatDir, floorY)

	if golem:GetAttribute("GroundPivotOffset") == nil or forceRecalibrate then
		local bboxCF, bboxSize = golem:GetBoundingBox()
		local bottomY = bboxCF.Position.Y - (bboxSize.Y / 2)
		local err = floorY - bottomY
		if math.abs(err) > 0.01 then
			golem:PivotTo(golem:GetPivot() + Vector3.new(0, err, 0))
		end
		calibrateGroundOffset(golem)
	end
end

local function applyGolemCollisionSetup(golem, root, isActive)
	for _, part in ipairs(golem:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CollisionGroup = "RoomBGolems"
			part.Massless = (part ~= root)

			if isActive then
				-- Root stays anchored so PivotTo locomotion is authoritative.
				-- Other parts stay unanchored so Motor6D animations can play.
				if part == root then
					part.Anchored = true
					part.CanCollide = true
				else
					part.Anchored = false
					part.CanCollide = false
					part.CanTouch = false
				end
			else
				-- Dormant: fully anchored, immovable, still solid for presence.
				part.Anchored = true
				part.CanCollide = (part == root)
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
end

local function applyPlayerCollisionGroup(character)
	if not character then
		return
	end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
