local function showDurability(remaining, maxDurability)
	hideToken += 1
	local token = hideToken

	frame.Visible = true
	frame.BackgroundTransparency = 0.15
	title.TextTransparency = 0
	value.TextTransparency = 0
	stroke.Transparency = 0.2
	value.Text = string.format("Durability: %d/%d", math.floor(remaining), math.floor(maxDurability))

