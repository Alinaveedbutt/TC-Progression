-- RoomCMoteEncounter.lua
-- Authoritative Room C Heart / blue-mote encounter runtime.
-- Place as ModuleScript under ServerScriptService.
--
-- Started once after chamber PivotTo via:
--   _G.RoomCMoteEncounter.start(dais, opts)
-- opts: { startCaveIn = fn(dais, player), cameraShakeRemote = RemoteEvent? }

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

------------------------------------------------------------------------
-- Configurable encounter balance
------------------------------------------------------------------------
local CONFIG = {
	MOTE_COUNT = 7,
	-- Spacing / orbit (studs). Larger = clearer separation between motes.
	MOTE_BASE_RADIUS = 24,
	MOTE_RADIUS_STEP = 1.6,
	MOTE_RADIUS_VAR = 2.2,
	MOTE_VERTICAL_AMP = 2.8,
	MOTE_SECONDARY_AMP = 1.2,

	-- Room C combat bubble (players outside are ignored)
	ROOM_C_COMBAT_RADIUS = 58,

	-- Mote orbit hazard (zone around the Heart) — reduced 60% from prior tuning
	HAZARD_DAMAGE = 4,
	HAZARD_INTERVAL = 0.85,
	HAZARD_RADIUS_PAD = 3,
	HAZARD_HEIGHT_PAD = 6,

	-- Close-range contact when a player is near an alive mote
	CONTACT_DAMAGE = 4,
	CONTACT_COOLDOWN = 0.7,
	CONTACT_RADIUS = 4.5,

	-- Ranged magical ray attacks
	RAY_DAMAGE = 6,
	RAY_COOLDOWN_MIN = 2.8,
	RAY_COOLDOWN_MAX = 4.2,
	RAY_TELEGRAPH = 0.65,
	RAY_TRAVEL = 0.55,
	RAY_HIT_RADIUS = 4.2,
	RAY_MAX_RANGE = 70,
	RAY_STAGGER = 0.3,

	-- Weakening (exactly 2 spell hits to dissolve)
	MAX_WEAKNESS = 100,
	HITS_TO_KILL = 2,
	DISSOLVE_DURATION = 0.35,
	MAX_CONCURRENT_ATTACKS = 2,

	-- Heart
	ATTR_UNLOCKED = "HeartUnlocked",
	ATTR_ALL_DISSOLVED = "AllMotesDissolved",
	ATTR_LIVING = "LivingSystemsStarted",
}

local activeEncounters = {} -- [dais] = state
local moteRegistry = {} -- [orb] = state (authoritative hit lookup)

local function resolveEncounterState(mote)
	local state = moteRegistry[mote]
	if state then
		return state
	end

	local dais = mote:FindFirstAncestor("SacredDais")
	state = dais and activeEncounters[dais]
	if state then
		return state
	end

	for _, encounterState in pairs(activeEncounters) do
		if encounterState.orbFolder and mote:IsDescendantOf(encounterState.orbFolder) then
			return encounterState
		end
	end

	return nil
end

local function getHeartCenter(dais, crystal)
	local tier = dais:FindFirstChild("DaisTier_3")
	if tier then
		return tier.Position + Vector3.new(0, 6.5, 0)
	end
	if crystal then
		return crystal.Position
	end
	return dais:GetPivot().Position + Vector3.new(0, 10, 0)
end

local function getChamberRoot()
	return Workspace:FindFirstChild("TrialChamberGeneratedV5_Sky")
		or Workspace:FindFirstChild("TrialChamberActive")
		or Workspace:FindFirstChild("TrialChamberV2")
end

-- Spell grant uses the dungeon spine so it fires at the Room C doorway, not at the Heart.
local function isPastRoomCDoor(worldPos)
	local root = getChamberRoot()
	if root and worldPos then
		local z = root:GetPivot():PointToObjectSpace(worldPos).Z
		return z >= 425 and z < 555
	end
	return false
end

-- Combat is Room C only — ignore players still in B / the BC corridor.
local function isInsideRoomC(worldPos, roomCenter)
	if not worldPos or not roomCenter then
		return false
	end
	local horiz = Vector3.new(worldPos.X - roomCenter.X, 0, worldPos.Z - roomCenter.Z).Magnitude
	local vert = math.abs(worldPos.Y - roomCenter.Y)
	return horiz <= CONFIG.ROOM_C_COMBAT_RADIUS and vert <= 40
end

local function countAliveMotes(orbFolder)
	local n = 0
	if not orbFolder then
		return 0
	end
	for _, orb in ipairs(orbFolder:GetChildren()) do
		if orb:IsA("BasePart") and CollectionService:HasTag(orb, "RoomCBlueMote") then
			if orb:GetAttribute("Dissolved") ~= true then
				n += 1
			end
		end
	end
	return n
end

local function countAliveMotesInState(state)
	local n = 0
	if not state or not state.motes then
		return 0
	end
	for orb, moteState in pairs(state.motes) do
		if moteState.alive and orb.Parent and orb:GetAttribute("Dissolved") ~= true then
			n += 1
		end
	end
	return n
end

local function getHeartPrompt(state)
	if state.anchor and state.anchor.Parent then
		local prompt = state.anchor:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			state.prompt = prompt
			return prompt
		end
	end
	if state.dais and state.dais.Parent then
		local anchor = state.dais:FindFirstChild("HeartPromptAnchor", true)
		if anchor then
			state.anchor = anchor
			local prompt = anchor:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				state.prompt = prompt
				return prompt
			end
		end
		local nested = state.dais:FindFirstChildWhichIsA("ProximityPrompt", true)
		if nested then
			state.prompt = nested
			return nested
		end
	end
	return state.prompt
end

local function ensureHeartPrompt(state)
	if not state or not state.dais then
		return nil
	end

	local anchor = state.anchor
	if not (anchor and anchor.Parent) then
		anchor = state.dais:FindFirstChild("HeartPromptAnchor", true)
	end
	if not anchor then
		local center = getHeartCenter(state.dais, state.crystal)
		anchor = Instance.new("Part")
		anchor.Name = "HeartPromptAnchor"
		anchor.Size = Vector3.new(8, 8, 8)
		anchor.CFrame = CFrame.new(center)
		anchor.Transparency = 1
		anchor.CanCollide = false
		anchor.CanTouch = false
		anchor.Anchored = true
		anchor.Parent = state.dais
	end

	anchor.CanQuery = true
	anchor.CanTouch = false
	anchor.CanCollide = false
	state.anchor = anchor

	local function configurePrompt(prompt)
		prompt.Style = Enum.ProximityPromptStyle.Default
		prompt.HoldDuration = 0
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = 24
		prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
		prompt.ObjectText = "Heart Crystal (Sealed)"
		prompt.ActionText = "Defeat the motes first"
		prompt.Enabled = false
	end

	local prompt = anchor:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "HeartCollectPrompt"
		prompt.Parent = anchor
	end
	configurePrompt(prompt)

	-- Visible crystal is the interactable players actually look at.
	local crystal = state.crystal
	if crystal and crystal:IsA("BasePart") then
		crystal.CanQuery = true
		local crystalPrompt = crystal:FindFirstChild("HeartCollectPrompt")
		if not crystalPrompt then
			crystalPrompt = Instance.new("ProximityPrompt")
			crystalPrompt.Name = "HeartCollectPrompt"
			crystalPrompt.Parent = crystal
		end
		configurePrompt(crystalPrompt)
	end

	state.prompt = prompt
	return prompt
end

local function getMoteBaseColor(orb)
	local r = orb:GetAttribute("BaseColorR")
	local g = orb:GetAttribute("BaseColorG")
	local b = orb:GetAttribute("BaseColorB")
	if r and g and b then
		return Color3.new(r, g, b)
	end
	return orb.Color
end

local function getRemainingDurability(orb)
	local maxW = orb:GetAttribute("MaxWeakness") or CONFIG.MAX_WEAKNESS
	local damage = orb:GetAttribute("Weakness") or 0
	return math.max(0, maxW - damage), maxW
end

local function applyMoteVisualWeakness(orb)
	if orb:GetAttribute("Dissolved") == true then
		return
	end

	local remaining, maxW = getRemainingDurability(orb)
	local durabilityRatio = math.clamp(remaining / math.max(maxW, 1), 0, 1)

	local baseColor = getMoteBaseColor(orb)
	local baseSize = orb:GetAttribute("BaseSize") or 2.2

	-- Smooth gradient: bright original → darker → black as durability falls.
	local darkened = baseColor:Lerp(Color3.new(0, 0, 0), 1 - durabilityRatio)
	orb.Color = darkened
	orb.Size = Vector3.new(baseSize, baseSize, baseSize) * (0.75 + 0.25 * durabilityRatio)
	orb.Transparency = 0.05 + (1 - durabilityRatio) * 0.35

	local light = orb:FindFirstChildOfClass("PointLight")
	if light then
		light.Brightness = 2.4 * durabilityRatio
		light.Range = 18 * (0.5 + 0.5 * durabilityRatio)
	end

	local spark = orb:FindFirstChildOfClass("ParticleEmitter")
	if spark then
		spark.Color = ColorSequence.new(darkened)
		spark.Rate = 6 * durabilityRatio
	end
end

local unlockHeart
local lockHeart
local tryUnlockHeart

unlockHeart = function(state)
	if not state or state.heartPhase == "HEART_CLAIMED" then
		return
	end
	state.heartUnlocked = true
	state.heartPhase = "HEART_CLAIMABLE"
	state.dais:SetAttribute(CONFIG.ATTR_UNLOCKED, true)
	state.dais:SetAttribute(CONFIG.ATTR_ALL_DISSOLVED, true)

	local prompt = ensureHeartPrompt(state)
	if prompt then
		for _, inst in ipairs(state.dais:GetDescendants()) do
			if inst:IsA("ProximityPrompt") then
				inst.Enabled = true
				inst.ObjectText = "Heart Crystal"
				inst.ActionText = "Take the Heart"
			end
		end
		print("[ROOM C HEART] Claim prompt enabled (Press E)")
	else
		warn("[ROOM C HEART] Heart unlocked but ProximityPrompt could not be created")
	end

	local crystal = state.crystal
	if crystal then
		local hl = crystal:FindFirstChildOfClass("Highlight")
		if not hl then
			hl = Instance.new("Highlight")
			hl.FillColor = Color3.fromRGB(255, 220, 80)
			hl.OutlineColor = Color3.fromRGB(255, 255, 160)
			hl.FillTransparency = 0.35
			hl.Parent = crystal
		end
		local light = crystal:FindFirstChildOfClass("PointLight")
		if light then
			TweenService:Create(light, TweenInfo.new(0.6), { Brightness = 7, Range = 95 }):Play()
		end
	end

	print("[ROOM C HEART] Heart Crystal UNLOCKED")
end

lockHeart = function(state)
	if not state then
		return
	end
	state.heartUnlocked = false
	state.heartPhase = "MOTES_ACTIVE"
	state.dais:SetAttribute(CONFIG.ATTR_UNLOCKED, false)
	state.dais:SetAttribute(CONFIG.ATTR_ALL_DISSOLVED, false)

	ensureHeartPrompt(state)
	for _, inst in ipairs(state.dais:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			inst.Enabled = false
			inst.ObjectText = "Heart Crystal (Sealed)"
			inst.ActionText = "Defeat the motes first"
		end
	end
end

tryUnlockHeart = function(state)
	if not state then
		return
	end
	if state.heartPhase == "HEART_CLAIMED" then
		return
	end

	local aliveFolder = countAliveMotes(state.orbFolder)
	local aliveState = countAliveMotesInState(state)
	state.motesRemaining = math.min(aliveFolder, aliveState)

	if aliveFolder > 0 or aliveState > 0 then
		return
	end

	if state.heartPhase ~= "HEART_CLAIMABLE" then
		state.heartPhase = "ALL_MOTES_DEFEATED"
		print("[ROOM C HEART] All motes defeated - unlocking Heart Crystal")
	end
	unlockHeart(state)
end

local function damagePlayerHumanoid(humanoid, amount, reason)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	local dmg = math.max(0, amount or 0)
	if dmg <= 0 then
		return false
	end
	-- Direct Health write so ForceFields / TakeDamage filters cannot zero out mote damage.
	humanoid.Health = math.max(0, humanoid.Health - dmg)
	if reason then
		print("[ROOM C HAZARD] " .. reason .. " for " .. tostring(dmg))
	end
	return true
end

local function dissolveMote(state, orb)
	if not orb then
		return
	end
	if orb:GetAttribute("Dissolved") == true then
		return
	end

	-- Immediately remove from combat/targeting — do NOT leave a lingering black orb.
	orb:SetAttribute("Dissolved", true)
	orb:SetAttribute("Weakness", orb:GetAttribute("MaxWeakness") or CONFIG.MAX_WEAKNESS)
	moteRegistry[orb] = nil

	if state and state.motes then
		local moteState = state.motes[orb]
		if moteState then
			moteState.alive = false
		end
		state.motes[orb] = nil
		if state.motesRemaining ~= nil then
			state.motesRemaining = math.max(0, state.motesRemaining - 1)
		end
	end

	orb.CanTouch = false
	orb.CanQuery = false
	orb.CanCollide = false

	local light = orb:FindFirstChildOfClass("PointLight")
	if light then
		light.Brightness = 0
		light.Enabled = false
	end

	local spark = orb:FindFirstChildOfClass("ParticleEmitter")
	if spark then
		spark.Enabled = false
	end

	-- Brief grey burst, then destroy the mote so it actually disappears.
	local burst = Instance.new("Part")
	burst.Name = "MoteDissolveBurst"
	burst.Shape = Enum.PartType.Ball
	burst.Size = orb.Size * 1.15
	burst.CFrame = orb.CFrame
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanQuery = false
	burst.Material = Enum.Material.Neon
	burst.Color = Color3.fromRGB(180, 230, 255)
	burst.Transparency = 0.2
	burst.Parent = Workspace

	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(140, 210, 255))
	pe.Size = NumberSequence.new(0.7, 0)
	pe.Lifetime = NumberRange.new(0.25, 0.5)
	pe.Rate = 0
	pe.Speed = NumberRange.new(3, 8)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = burst
	pe:Emit(18)
	Debris:AddItem(burst, 0.55)

	TweenService:Create(burst, TweenInfo.new(CONFIG.DISSOLVE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Transparency = 1,
		Size = Vector3.new(0.1, 0.1, 0.1),
	}):Play()

	-- Hide + destroy the mote immediately (no stuck black ball).
	orb.Transparency = 1
	orb.Size = Vector3.new(0.05, 0.05, 0.05)
	orb:Destroy()

	local remaining = state and countAliveMotes(state.orbFolder) or 0
	print("[ROOM C MOTES] Mote destroyed — remaining: " .. tostring(remaining))

	if state then
		tryUnlockHeart(state)
	end
end

local function findNearestPlayerInRoomC(center, maxRange, roomCenter)
	local bestPlayer, bestHrp, bestDist = nil, nil, maxRange
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 and isInsideRoomC(hrp.Position, roomCenter) then
			local d = (hrp.Position - center).Magnitude
			if d < bestDist then
				bestDist = d
				bestPlayer = player
				bestHrp = hrp
			end
		end
	end
	return bestPlayer, bestHrp, bestDist
end

local function fireMoteRay(state, orb, targetHrp)
	if not orb.Parent or orb:GetAttribute("Dissolved") == true then
		return
	end
	if not targetHrp or not targetHrp.Parent then
		return
	end

	local roomCenter = getHeartCenter(state.dais, state.crystal)
	if not isInsideRoomC(targetHrp.Position, roomCenter) then
		return
	end

	local origin = orb.Position
	local aimPos = targetHrp.Position + Vector3.new(0, 1.2, 0)
	local dist = (aimPos - origin).Magnitude
	if dist > CONFIG.RAY_MAX_RANGE or dist < 1 then
		return
	end

	-- Telegraph: the mote itself flares — no laser line to the player.
	local baseSize = orb:GetAttribute("BaseSize") or orb.Size.X
	local light = orb:FindFirstChildOfClass("PointLight")
	local oldBright = light and light.Brightness or 2.4
	local oldSize = orb.Size
	if light then
		light.Brightness = oldBright * 2.4
	end
	TweenService:Create(orb, TweenInfo.new(CONFIG.RAY_TELEGRAPH, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Size = Vector3.new(baseSize, baseSize, baseSize) * 1.35,
	}):Play()

	local halo = Instance.new("Part")
	halo.Name = "MoteChargeHalo"
	halo.Shape = Enum.PartType.Ball
	halo.Size = Vector3.new(baseSize * 1.6, baseSize * 1.6, baseSize * 1.6)
	halo.CFrame = orb.CFrame
	halo.Anchored = true
	halo.CanCollide = false
	halo.CanQuery = false
	halo.Material = Enum.Material.Neon
	halo.Color = Color3.fromRGB(180, 230, 255)
	halo.Transparency = 0.55
	halo.Parent = Workspace
	TweenService:Create(halo, TweenInfo.new(CONFIG.RAY_TELEGRAPH, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(baseSize * 3.2, baseSize * 3.2, baseSize * 3.2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(halo, CONFIG.RAY_TELEGRAPH + 0.05)

	task.wait(CONFIG.RAY_TELEGRAPH)
	if halo.Parent then
		halo:Destroy()
	end
	if orb.Parent and orb:GetAttribute("Dissolved") ~= true then
		orb.Size = oldSize
	end
	if light and light.Parent then
		light.Brightness = oldBright
	end

	if not orb.Parent or orb:GetAttribute("Dissolved") == true then
		return
	end
	if not targetHrp.Parent or not isInsideRoomC(targetHrp.Position, roomCenter) then
		return
	end

	origin = orb.Position
	aimPos = targetHrp.Position + Vector3.new(0, 1.2, 0)

	local humanoid = targetHrp.Parent:FindFirstChildOfClass("Humanoid")
	local player = Players:GetPlayerFromCharacter(targetHrp.Parent)

	-- Zap: jagged Beam + short Trail, damage applied the same frame the bolt appears.
	local holder = Instance.new("Folder")
	holder.Name = "MoteZap"
	holder.Parent = Workspace

	local function makeZapNode(pos, name)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = Vector3.new(0.15, 0.15, 0.15)
		part.Transparency = 1
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CFrame = CFrame.new(pos)
		part.Parent = holder
		local att = Instance.new("Attachment")
		att.Parent = part
		return part, att
	end

	local kink = Vector3.new(
		(math.random() - 0.5) * 5,
		(math.random() - 0.5) * 4 + 1,
		(math.random() - 0.5) * 5
	)
	local mid = origin:Lerp(aimPos, 0.5) + kink
	local _, attA = makeZapNode(origin, "ZapStart")
	local midPart, attM = makeZapNode(mid, "ZapMid")
	local endPart, attB = makeZapNode(aimPos, "ZapEnd")

	local function makeZapBeam(a0, a1, width)
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Color = ColorSequence.new(Color3.fromRGB(170, 230, 255), Color3.fromRGB(255, 255, 255))
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Width0 = width
		beam.Width1 = width * 0.4
		beam.FaceCamera = true
		beam.Segments = 16
		beam.CurveSize0 = (math.random() - 0.5) * 5
		beam.CurveSize1 = (math.random() - 0.5) * 5
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureMode = Enum.TextureMode.Wrap
		beam.TextureLength = 2
		beam.TextureSpeed = 12
		beam.Transparency = NumberSequence.new(0.05, 0.35)
		beam.Parent = holder
		return beam
	end

	local beam1 = makeZapBeam(attA, attM, 0.7)
	local beam2 = makeZapBeam(attM, attB, 0.45)

	local trailA = Instance.new("Attachment")
	trailA.Position = Vector3.new(-0.08, 0, 0)
	trailA.Parent = endPart
	local trailB = Instance.new("Attachment")
	trailB.Position = Vector3.new(0.08, 0, 0)
	trailB.Parent = endPart
	local trail = Instance.new("Trail")
	trail.Attachment0 = trailA
	trail.Attachment1 = trailB
	trail.Lifetime = 0.18
	trail.FaceCamera = true
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(190, 235, 255))
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Parent = endPart

	local flash = Instance.new("Part")
	flash.Name = "ZapImpact"
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(0.5, 0.5, 0.5)
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(210, 240, 255)
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.Transparency = 0.15
	flash.CFrame = CFrame.new(aimPos)
	flash.Parent = holder
	local burst = Instance.new("ParticleEmitter")
	burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	burst.Rate = 0
	burst.Lifetime = NumberRange.new(0.15, 0.3)
	burst.Speed = NumberRange.new(6, 12)
	burst.Size = NumberSequence.new(0.3, 0)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Color = ColorSequence.new(Color3.fromRGB(180, 230, 255))
	burst.LightEmission = 1
	burst.Parent = flash
	burst:Emit(16)

	local zapLight = Instance.new("PointLight")
	zapLight.Color = Color3.fromRGB(170, 230, 255)
	zapLight.Brightness = 3
	zapLight.Range = 12
	zapLight.Parent = flash

	if humanoid and humanoid.Health > 0 then
		damagePlayerHumanoid(humanoid, CONFIG.RAY_DAMAGE, "Mote zap hit " .. (player and player.Name or "player"))
	end

	TweenService:Create(flash, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(2.2, 2.2, 2.2),
		Transparency = 1,
	}):Play()
	TweenService:Create(zapLight, TweenInfo.new(0.22), { Brightness = 0 }):Play()

	task.spawn(function()
		local fade = 0.22
		local t0 = os.clock()
		while os.clock() - t0 < fade and holder.Parent do
			local a = math.clamp((os.clock() - t0) / fade, 0, 1)
			beam1.Width0 = 0.7 * (1 - a)
			beam1.Width1 = 0.28 * (1 - a)
			beam2.Width0 = 0.45 * (1 - a)
			beam2.Width1 = 0.18 * (1 - a)
			beam1.Transparency = NumberSequence.new(0.05 + a * 0.95, 1)
			beam2.Transparency = NumberSequence.new(0.05 + a * 0.95, 1)
			task.wait()
		end
		if holder.Parent then
			holder:Destroy()
		end
	end)
	Debris:AddItem(holder, 0.45)
end

local function startMoteAttackLoop(state, orb, index)
	local moteState = state.motes[orb]
	if not moteState then
		return
	end

	state.activeMoteAttacks = state.activeMoteAttacks or 0

	task.spawn(function()
		task.wait(CONFIG.RAY_STAGGER * index)
		print("[ROOM C] Mote attack armed (" .. orb.Name .. ") — Room C targets only")

		while moteState.alive and orb.Parent and orb:GetAttribute("Dissolved") ~= true do
			local cooldown = CONFIG.RAY_COOLDOWN_MIN
				+ math.random() * (CONFIG.RAY_COOLDOWN_MAX - CONFIG.RAY_COOLDOWN_MIN)
			task.wait(cooldown)

			if not moteState.alive or not orb.Parent or orb:GetAttribute("Dissolved") == true then
				break
			end
			if state.ended then
				break
			end
			if (state.activeMoteAttacks or 0) < CONFIG.MAX_CONCURRENT_ATTACKS then
				local roomCenter = getHeartCenter(state.dais, state.crystal)
				local center = orb.Position
				local player, hrp = findNearestPlayerInRoomC(center, CONFIG.RAY_MAX_RANGE, roomCenter)
				if player and hrp then
					state.activeMoteAttacks = (state.activeMoteAttacks or 0) + 1
					local ok, err = pcall(fireMoteRay, state, orb, hrp)
					state.activeMoteAttacks = math.max(0, (state.activeMoteAttacks or 1) - 1)
					if not ok then
						warn("[ROOM C] Mote ray failed: " .. tostring(err))
					end
				end
			end
		end
	end)
end

local function applyMoteSpellHit(mote, player, amount)
	if not mote or not mote.Parent then
		return false
	end
	if mote:GetAttribute("Dissolved") == true then
		return false
	end
	if not CollectionService:HasTag(mote, "RoomCBlueMote") then
		return false
	end

	local state = resolveEncounterState(mote)
	local maxW = mote:GetAttribute("MaxWeakness") or CONFIG.MAX_WEAKNESS
	local prevDamage = mote:GetAttribute("Weakness") or 0
	local prevRemaining = math.max(0, maxW - prevDamage)
	local hitAmount = maxW / math.max(1, CONFIG.HITS_TO_KILL or 2)
	local newDamage = math.min(maxW, prevDamage + hitAmount)
	local newRemaining = math.max(0, maxW - newDamage)

	mote:SetAttribute("Weakness", newDamage)

	print("[ROOM C MOTES] Mote " .. mote.Name .. " hit")
	print("[ROOM C MOTES] Durability: " .. tostring(prevRemaining) .. " -> " .. tostring(newRemaining))

	applyMoteVisualWeakness(mote)

	-- At 0 HP: destroy immediately (do not leave a black orb behind).
	if newRemaining <= 0 or newDamage >= maxW then
		print("[ROOM C MOTES] " .. mote.Name .. " reached 0 HP — dissolving")
		if state then
			dissolveMote(state, mote)
		else
			mote:SetAttribute("Dissolved", true)
			mote.Transparency = 1
			mote:Destroy()
			moteRegistry[mote] = nil
		end
	end

	return true
end

local function onWeaknessChanged(mote, weakness, maxWeakness, player)
	-- Legacy hook: re-route through the single authoritative hit pipeline.
	local prevDamage = mote:GetAttribute("Weakness") or 0
	if weakness <= prevDamage then
		return
	end
	local delta = weakness - prevDamage
	mote:SetAttribute("Weakness", prevDamage)
	applyMoteSpellHit(mote, player, delta)
end

local function start(dais, opts)
	opts = opts or {}
	if not dais or not dais.Parent then
		warn("[ROOM C] Encounter start failed: missing dais")
		return
	end

	if dais:GetAttribute(CONFIG.ATTR_LIVING) == true and activeEncounters[dais] then
		print("[ROOM C] Encounter already running — skip duplicate start")
		return
	end

	local heartModel = dais:FindFirstChild("HeartCrystal")
	local crystal = (heartModel and heartModel:FindFirstChild("TheHeartCrystal"))
		or dais:FindFirstChild("TheHeartCrystal")
	local anchor = dais:FindFirstChild("HeartPromptAnchor")
	local orbFolder = dais:FindFirstChild("ArcaneOrbs")
	if not crystal or not orbFolder then
		warn("[ROOM C] Encounter start failed: missing Heart/motes")
		return
	end

	dais:SetAttribute(CONFIG.ATTR_LIVING, true)

	local state = {
		dais = dais,
		crystal = crystal,
		heartModel = heartModel,
		anchor = anchor,
		orbFolder = orbFolder,
		prompt = nil,
		motes = {},
		motesRemaining = CONFIG.MOTE_COUNT,
		heartPhase = "MOTES_ACTIVE",
		ended = false,
		heartUnlocked = false,
		opts = opts,
		floatConn = nil,
		hazardConn = nil,
		heartPromptHooked = false,
	}
	state.unlockHeart = function()
		unlockHeart(state)
	end
	state.tryUnlockHeart = function()
		tryUnlockHeart(state)
	end

	activeEncounters[dais] = state

	local prompt = ensureHeartPrompt(state)
	anchor = state.anchor

	-- Re-apply spacing config from attributes / CONFIG onto motes
	local moteList = {}
	for _, orb in ipairs(orbFolder:GetChildren()) do
		if orb:IsA("BasePart") and CollectionService:HasTag(orb, "RoomCBlueMote") then
			table.insert(moteList, orb)
		end
	end
	table.sort(moteList, function(a, b)
		return (a:GetAttribute("MoteIndex") or 0) < (b:GetAttribute("MoteIndex") or 0)
	end)

	print("[ROOM A MOTES] Active mote count: " .. tostring(#moteList))

	if #moteList ~= CONFIG.MOTE_COUNT then
		warn("[ROOM A MOTES] Expected " .. CONFIG.MOTE_COUNT .. " motes, found " .. tostring(#moteList))
	end

	for i, orb in ipairs(moteList) do
		local idx = orb:GetAttribute("MoteIndex") or (i - 1)
		local phase = (idx / math.max(#moteList, 1)) * math.pi * 2
		local baseRadius = CONFIG.MOTE_BASE_RADIUS + (idx % 3) * CONFIG.MOTE_RADIUS_STEP

		orb:SetAttribute("Phase", phase)
		orb:SetAttribute("BaseRadius", baseRadius)
		orb:SetAttribute("RadiusVar", CONFIG.MOTE_RADIUS_VAR)
		orb:SetAttribute("VerticalAmp", CONFIG.MOTE_VERTICAL_AMP)
		orb:SetAttribute("SecondaryAmp", CONFIG.MOTE_SECONDARY_AMP)
		orb:SetAttribute("MaxWeakness", CONFIG.MAX_WEAKNESS)
		orb:SetAttribute("Weakness", 0)
		if orb:GetAttribute("BaseSize") == nil then
			orb:SetAttribute("BaseSize", orb.Size.X)
		end
		if orb:GetAttribute("BaseColorR") == nil then
			orb:SetAttribute("BaseColorR", orb.Color.R)
			orb:SetAttribute("BaseColorG", orb.Color.G)
			orb:SetAttribute("BaseColorB", orb.Color.B)
		end
		CollectionService:AddTag(orb, "RoomCBlueMote")
		orb:SetAttribute("Dissolved", false)

		state.motes[orb] = { alive = true, index = i }
		moteRegistry[orb] = state
		applyMoteVisualWeakness(orb)
		startMoteAttackLoop(state, orb, i)
	end

	state.motesRemaining = #moteList

	-- Heart locked until all motes dissolve (server-side)
	if state.motesRemaining <= 0 then
		tryUnlockHeart(state)
	else
		lockHeart(state)
	end

	-- Grant spell to anyone already standing in Room C (doorway counts).
	local spell = _G.TrialSpell
	if not spell then
		local mod = game:GetService("ServerScriptService"):FindFirstChild("TrialChamberSpellBridge")
			or game:GetService("ServerScriptService"):FindFirstChild("RoomC_Attack_Spell")
		if mod and mod:IsA("ModuleScript") then
			spell = require(mod)
		end
	end
	if spell then
		for _, player in ipairs(Players:GetPlayers()) do
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp and (isPastRoomCDoor(hrp.Position) or isInsideRoomC(hrp.Position, getHeartCenter(dais, crystal))) then
				if type(spell.unlockSpell) == "function" then
					spell.unlockSpell(player)
				elseif type(spell.restoreSpellAfterRespawn) == "function" then
					spell.restoreSpellAfterRespawn(player)
				end
				if type(spell.orderHotbar) == "function" then
					spell.orderHotbar(player)
				end
			end
		end
	else
		warn("[ROOM C] TrialChamberSpellBridge not found — mote weakening spells unavailable")
	end

	-- Motion + crystal bob
	state.floatConn = RunService.Heartbeat:Connect(function()
		if state.ended or not crystal.Parent then
			return
		end

		local t = os.clock()
		local center = getHeartCenter(dais, crystal)
		local newY = center.Y + math.sin(t * 1.8) * 0.55

		crystal.CFrame = CFrame.new(center.X, newY, center.Z)
			* CFrame.Angles(0, math.rad(t * 25), 0)

		if heartModel then
			local facetA = heartModel:FindFirstChild("HeartFacetA")
			local facetB = heartModel:FindFirstChild("HeartFacetB")
			if facetA then
				facetA.CFrame = crystal.CFrame * CFrame.Angles(0, 0, math.rad(45))
			end
			if facetB then
				facetB.CFrame = crystal.CFrame * CFrame.Angles(math.rad(45), math.rad(90), 0)
			end
		end
		if state.anchor then
			state.anchor.CFrame = CFrame.new(center.X, newY, center.Z)
		end

		for orb, moteState in pairs(state.motes) do
			if moteState.alive and orb.Parent and orb:GetAttribute("Dissolved") ~= true then
				local phase = orb:GetAttribute("Phase") or 0
				local baseRadius = orb:GetAttribute("BaseRadius") or CONFIG.MOTE_BASE_RADIUS
				local orbitSpeed = orb:GetAttribute("OrbitSpeed") or 0.7
				local vFreq = orb:GetAttribute("VerticalFreq") or 1.2
				local vAmp = orb:GetAttribute("VerticalAmp") or CONFIG.MOTE_VERTICAL_AMP
				local sFreq = orb:GetAttribute("SecondaryFreq") or 1.8
				local sAmp = orb:GetAttribute("SecondaryAmp") or CONFIG.MOTE_SECONDARY_AMP
				local rFreq = orb:GetAttribute("RadiusFreq") or 0.8
				local rVar = orb:GetAttribute("RadiusVar") or CONFIG.MOTE_RADIUS_VAR

				local angle = t * orbitSpeed + phase
				local radius = baseRadius + math.sin(t * rFreq + phase) * rVar
				local x = center.X + math.cos(angle) * radius
				local z = center.Z + math.sin(angle) * radius
				local y = newY
					+ math.sin(t * vFreq + phase) * vAmp
					+ math.sin(t * sFreq + phase * 1.7) * sAmp
				orb.CFrame = CFrame.new(x, y, z)
			end
		end
	end)

	-- Orbit-zone + per-mote contact hazards.
	-- Single server loop (no Touched spam).
	local hazardInsideTime = {}
	local contactCooldown = {} -- [userId] = os.clock()
	local grantedSpell = {}
	local hazardRadius = CONFIG.MOTE_BASE_RADIUS
		+ CONFIG.MOTE_RADIUS_STEP * 2
		+ CONFIG.MOTE_RADIUS_VAR
		+ (CONFIG.HAZARD_RADIUS_PAD or 3)
	local hazardHalfHeight = CONFIG.MOTE_VERTICAL_AMP
		+ CONFIG.MOTE_SECONDARY_AMP
		+ (CONFIG.HAZARD_HEIGHT_PAD or 6)
	state.hazardConn = RunService.Heartbeat:Connect(function(dt)
		if state.ended then
			return
		end
		if state.heartUnlocked or countAliveMotesInState(state) <= 0 then
			for uid in pairs(hazardInsideTime) do
				hazardInsideTime[uid] = nil
			end
			return
		end

		local center = getHeartCenter(dais, crystal)
		local seen = {}
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local uid = player.UserId
			seen[uid] = true
			-- Grant at the Room C doorway even if the player is not yet in the Heart bubble.
			if hrp and humanoid and humanoid.Health > 0 and not grantedSpell[uid] and isPastRoomCDoor(hrp.Position) then
				grantedSpell[uid] = true
				if spell and type(spell.unlockSpell) == "function" then
					spell.unlockSpell(player)
					if type(spell.orderHotbar) == "function" then
						spell.orderHotbar(player)
					end
				end
			end
			-- Room C combat bubble — never damage players still in Room B / BC corridor.
			if hrp and humanoid and humanoid.Health > 0 and isInsideRoomC(hrp.Position, center) then
				local offset = hrp.Position - center
				local horiz = Vector3.new(offset.X, 0, offset.Z).Magnitude
				local vert = math.abs(offset.Y)
				if horiz <= hazardRadius and vert <= hazardHalfHeight then
					hazardInsideTime[uid] = (hazardInsideTime[uid] or 0) + dt
					if hazardInsideTime[uid] >= CONFIG.HAZARD_INTERVAL then
						hazardInsideTime[uid] = 0
						damagePlayerHumanoid(humanoid, CONFIG.HAZARD_DAMAGE, "Mote orbit damaged " .. player.Name)
					end
				else
					hazardInsideTime[uid] = 0
				end

				-- Close-range contact vs any alive mote
				local lastContact = contactCooldown[uid] or 0
				if (now - lastContact) >= CONFIG.CONTACT_COOLDOWN then
					for orb, moteState in pairs(state.motes) do
						if moteState.alive and orb.Parent and orb:GetAttribute("Dissolved") ~= true then
							if (hrp.Position - orb.Position).Magnitude <= CONFIG.CONTACT_RADIUS then
								contactCooldown[uid] = now
								damagePlayerHumanoid(humanoid, CONFIG.CONTACT_DAMAGE, "Mote contact damaged " .. player.Name)
								break
							end
						end
					end
				end
			else
				hazardInsideTime[uid] = 0
			end
		end
		for uid in pairs(hazardInsideTime) do
			if not seen[uid] then
				hazardInsideTime[uid] = nil
			end
		end
	end)

	print("[ROOM C HEART] Mote hazard active")

	-- Heart collection (server gate) — hook every prompt on the dais/crystal.
	if not state.heartPromptHooked then
		state.heartPromptHooked = true
		local function onHeartTriggered(player)
			if dais:GetAttribute(CONFIG.ATTR_UNLOCKED) ~= true then
				print("[ROOM C] Heart collect blocked for " .. player.Name .. " — motes remain")
				return
			end
			if countAliveMotes(orbFolder) > 0 or countAliveMotesInState(state) > 0 then
				print("[ROOM C] Heart collect blocked — alive motes still present")
				return
			end
			if state.heartPhase == "HEART_CLAIMED" then
				return
			end

			-- Consume every heart prompt once
			for _, inst in ipairs(dais:GetDescendants()) do
				if inst:IsA("ProximityPrompt") then
					inst.Enabled = false
				end
			end
			state.heartPhase = "HEART_CLAIMED"
			state.ended = true
			for _, moteState in pairs(state.motes) do
				moteState.alive = false
			end
			if state.floatConn then
				state.floatConn:Disconnect()
				state.floatConn = nil
			end
			if state.hazardConn then
				state.hazardConn:Disconnect()
				state.hazardConn = nil
			end

			local remote = opts.cameraShakeRemote
			if remote then
				remote:FireAllClients(true)
			end
			do
				local droppedChains = CollectionService:GetTagged("RoomC_ContainmentChain")
				for _, chainFolder in ipairs(droppedChains) do
					for _, inst in ipairs(chainFolder:GetChildren()) do
						if inst:IsA("BasePart") then
							inst.Anchored = false
							inst.CanCollide = true
							inst.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 6, -math.random() * 2, (math.random() - 0.5) * 6)
							inst.AssemblyAngularVelocity = Vector3.new((math.random() - 0.5) * 8, (math.random() - 0.5) * 8, (math.random() - 0.5) * 8)
						end
					end
				end
				print("[RoomC] Heart taken - shake started, " .. #droppedChains .. " containment chains released.")
			end

			crystal.Color = Color3.fromRGB(100, 100, 100)
			crystal.Material = Enum.Material.Glass
			for _, child in ipairs(crystal:GetDescendants()) do
				if child:IsA("PointLight") or child:IsA("Highlight") or child:IsA("ParticleEmitter") then
					child:Destroy()
				end
			end

			local ti = TweenInfo.new(3, Enum.EasingStyle.Linear)
			TweenService:Create(game:GetService("Lighting"), ti, { Ambient = Color3.fromRGB(30, 15, 15) }):Play()

			print("COLLAPSE SEQUENCE INITIATED - Wizard: 'Quickly, child! The chamber is unstable!'")
			if type(opts.startCaveIn) == "function" then
				local ok, err = pcall(opts.startCaveIn, dais, player)
				if not ok then
					warn("[RoomC] Cave-in failed: " .. tostring(err))
				end
			end
		end
		for _, inst in ipairs(dais:GetDescendants()) do
			if inst:IsA("ProximityPrompt") then
				inst.Triggered:Connect(onHeartTriggered)
			end
		end
	end

	dais.AncestryChanged:Connect(function(_, parent)
		if not parent then
			state.ended = true
			for _, moteState in pairs(state.motes) do
				moteState.alive = false
			end
			if state.floatConn then
				state.floatConn:Disconnect()
			end
			if state.hazardConn then
				state.hazardConn:Disconnect()
			end
			activeEncounters[dais] = nil
			for orb, encounterState in pairs(moteRegistry) do
				if encounterState == state then
					moteRegistry[orb] = nil
				end
			end
		end
	end)
end

local function cleanupLegacyMoteDurabilityUI()
	local starterPlayerScripts = game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts")
	if starterPlayerScripts then
		local legacy = starterPlayerScripts:FindFirstChild("TrialMoteDurabilityUI")
		if legacy then
			legacy:Destroy()
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local playerScripts = player:FindFirstChild("PlayerScripts")
		if playerScripts then
			local legacy = playerScripts:FindFirstChild("TrialMoteDurabilityUI")
			if legacy then
				legacy:Destroy()
			end
		end
		local playerGui = player:FindFirstChild("PlayerGui")
		if playerGui then
			local legacyGui = playerGui:FindFirstChild("TrialMoteDurabilityUI")
			if legacyGui then
				legacyGui:Destroy()
			end
		end
	end
end

