-- Progression_TrialChamber.lua
-- Room B player progression + GolemBaneSword combat (server-authoritative).
-- Responsibilities: sword creation, grant, swing, hit detection, damage.
-- Golem AI/health bars/activation remain in TrialChamberGolemController.

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local SWING_COOLDOWN = 0.5
local SWING_WINDOW = 0.25
local DAMAGE_FRACTION = 0.15 -- 15% of target MaxHealth per valid hit

------------------------------------------------------------------------
-- Sword construction
-- Blade built along Handle -Z (Tool forward). Grip rotates it into a
-- natural R15 hold: pommel in palm, blade extending forward from the hand.
------------------------------------------------------------------------

local function weldOffset(handle, part, relativeCFrame)
	local weld = Instance.new("Weld")
	weld.Name = part.Name .. "Weld"
	weld.Part0 = handle
	weld.Part1 = part
	weld.C0 = relativeCFrame
	weld.C1 = CFrame.new()
	weld.Parent = handle
end

local function makePart(props)
	local part = Instance.new(props.ClassName or "Part")
	part.Name = props.Name
	part.Material = props.Material or Enum.Material.Metal
	part.Color = props.Color or Color3.fromRGB(200, 200, 200)
	part.Size = props.Size
	if props.Shape then
		part.Shape = props.Shape
	end
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = true
	part.Parent = props.Parent
	return part
end

local function buildSwordTool()
	local tool = Instance.new("Tool")
	tool.Name = "GolemBaneSword"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "GolemBane Sword"

	-- R15 RightGrip: rotate so Handle -Z (blade) aims forward along the arm,
	-- not out to the side. Palm sits on the leather wrap.
	tool.Grip = CFrame.new(0, -0.1, -0.35) * CFrame.Angles(math.rad(-90), math.rad(-90), 0)

	-- Handle length along Z (Tool forward axis)
	local handle = makePart({
		Name = "Handle",
		Parent = tool,
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(78, 52, 30),
		Size = Vector3.new(0.28, 0.28, 1.05),
	})

	local wrap = makePart({
		Name = "GripWrap",
		Parent = tool,
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(55, 40, 28),
		Size = Vector3.new(0.32, 0.32, 0.55),
	})
	weldOffset(handle, wrap, CFrame.new(0, 0, 0.05))

	local guard = makePart({
		Name = "Guard",
		Parent = tool,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(170, 145, 70),
		Size = Vector3.new(0.95, 0.18, 0.16),
	})
	weldOffset(handle, guard, CFrame.new(0, 0, -0.55))

	local guardL = makePart({
		Name = "GuardCapL",
		Parent = tool,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(150, 125, 55),
		Size = Vector3.new(0.2, 0.2, 0.2),
		Shape = Enum.PartType.Ball,
	})
	weldOffset(handle, guardL, CFrame.new(-0.48, 0, -0.55))

	local guardR = makePart({
		Name = "GuardCapR",
		Parent = tool,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(150, 125, 55),
		Size = Vector3.new(0.2, 0.2, 0.2),
		Shape = Enum.PartType.Ball,
	})
	weldOffset(handle, guardR, CFrame.new(0.48, 0, -0.55))

	-- Blade extends forward (-Z)
	local blade = makePart({
		Name = "Blade",
		Parent = tool,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(205, 210, 220),
		Size = Vector3.new(0.12, 0.42, 2.4),
	})
	weldOffset(handle, blade, CFrame.new(0, 0, -1.85))

	local fuller = makePart({
		Name = "Fuller",
		Parent = tool,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(175, 180, 190),
		Size = Vector3.new(0.04, 0.18, 2.05),
	})
	weldOffset(handle, fuller, CFrame.new(0, 0, -1.75))

	local tip = makePart({
		ClassName = "WedgePart",
		Name = "Tip",
		Parent = tool,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(205, 210, 220),
		Size = Vector3.new(0.12, 0.42, 0.4),
	})
	weldOffset(handle, tip, CFrame.new(0, 0, -3.25) * CFrame.Angles(math.rad(-90), 0, 0))

	local pommel = makePart({
		Name = "Pommel",
		Parent = tool,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(170, 145, 70),
		Size = Vector3.new(0.32, 0.32, 0.32),
		Shape = Enum.PartType.Ball,
	})
	weldOffset(handle, pommel, CFrame.new(0, 0, 0.62))

	return tool, blade
end

local function findGolemModelFromPart(part)
	local current = part
	while current and current ~= Workspace do
		if current:IsA("Model") and CollectionService:HasTag(current, "Golem") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function bindSwordCombat(tool, blade, player)
	local canSwing = true
	local swingDamagedGolems = {}

	tool.Activated:Connect(function()
		if not canSwing then
			return
		end
		if not player.Character then
			return
		end

		canSwing = false
		table.clear(swingDamagedGolems)
		print("[ROOM B COMBAT] Sword swing started")

		local originalGrip = tool.Grip
		-- Mild swing arc
		tool.Grip = originalGrip * CFrame.Angles(math.rad(-40), math.rad(15), math.rad(25))

		task.spawn(function()
			local swingEnd = os.clock() + SWING_WINDOW
			while os.clock() < swingEnd do
				local character = player.Character
				if not character or not tool:IsDescendantOf(character) then
					break
				end

				local playerRoot = character:FindFirstChild("HumanoidRootPart")
				if playerRoot then
					local hitboxCFrame = playerRoot.CFrame * CFrame.new(0, 0.5, -3.5)
					local hitboxSize = Vector3.new(5, 5, 6)

					local overlapParams = OverlapParams.new()
					overlapParams.FilterDescendantsInstances = { player.Character, tool }
					overlapParams.FilterType = Enum.RaycastFilterType.Exclude

					local parts = Workspace:GetPartBoundsInBox(hitboxCFrame, hitboxSize, overlapParams)
					for _, part in ipairs(parts) do
						local model = findGolemModelFromPart(part)
						if model and not swingDamagedGolems[model] then
							local currentHealth = model:GetAttribute("Health")
							local isActive = model:GetAttribute("IsActive") == true
							if currentHealth and currentHealth > 0 and isActive then
								swingDamagedGolems[model] = true

								local maxHealth = model:GetAttribute("MaxHealth") or 200
								-- Optional per-golem absolute damage, so raising a golem's max
								-- health actually makes it tankier instead of scaling the hit
								-- up alongside it and keeping the fight the same length.
								local damage = model:GetAttribute("SwordDamage")
									or (maxHealth * DAMAGE_FRACTION)
								local newHealth = math.max(0, currentHealth - damage)
								model:SetAttribute("Health", newHealth)

								print("[ROOM B COMBAT] Sword hit " .. model.Name .. " for " .. tostring(damage))
								print("[ROOM B COMBAT] " .. model.Name .. " HP: " .. tostring(newHealth) .. "/" .. tostring(maxHealth))
							end
						end
					end
				end

				task.wait()
			end

			tool.Grip = originalGrip
			task.wait(math.max(0, SWING_COOLDOWN - SWING_WINDOW))
			canSwing = true
		end)
	end)
end

------------------------------------------------------------------------
-- Public API — GolemBaneSword grant / restore (idempotent)
------------------------------------------------------------------------

local ATTR_HAS_SWORD = "ReceivedRoomBSword" -- entitlement: earned Room B sword
local SWORD_NAME = "GolemBaneSword"

local Players = game:GetService("Players")
local hookedPlayers = {} -- [Player] = true — one CharacterAdded hook per player

local hookPlayerSwordPersistence -- forward declaration

local function playerHasSwordInstance(player)
	local backpack = player:FindFirstChild("Backpack")
	if backpack and backpack:FindFirstChild(SWORD_NAME) then
		return true
	end
	local character = player.Character
	if character and character:FindFirstChild(SWORD_NAME) then
		return true
	end
	return false
end

-- Room B sword is relevant while the player still needs it for the trial encounter.
local function isRoomBSwordRelevant(player)
	if not player then
		return false
	end
	if player:GetAttribute(ATTR_HAS_SWORD) ~= true then
		return false
	end

	local room = player:GetAttribute("CurrentTrialRoom")
	-- Active Room B fight — always restore.
	if room == "B" then
		return true
	end
	-- Later chambers: keep sword for the remainder of the Trial.
	if room == "C" or room == "D" then
		return true
	end

	-- Entitlement set but checkpoint race: golems still present in world.
	local container = Workspace:FindFirstChild("TrialChamberActiveGolems")
	if container then
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Model") and CollectionService:HasTag(child, "Golem") then
				local hp = child:GetAttribute("Health")
				if hp == nil or hp > 0 then
					return true
				end
			end
		end
	end

	return false
end

local function grantSwordInstance(player)
	local tool, blade = buildSwordTool()
	bindSwordCombat(tool, blade, player)

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then
		backpack = player:WaitForChild("Backpack", 8)
	end
	if not backpack then
		warn("[ROOM B COMBAT] Could not find Backpack for " .. player.Name)
		tool:Destroy()
		return false
	end

	-- Final duplicate check after waiting (another restore may have won the race).
	if backpack:FindFirstChild(SWORD_NAME) then
		tool:Destroy()
		return true
	end
	local character = player.Character
	if character and character:FindFirstChild(SWORD_NAME) then
		tool:Destroy()
		return true
	end

	tool.Parent = backpack
	if _G.TrialSpell and type(_G.TrialSpell.orderHotbar) == "function" then
		_G.TrialSpell.orderHotbar(player)
	end
	return true
end

local function rewardSword(player)
	if not player then
		return
	end

	local room = player:GetAttribute("CurrentTrialRoom")
	if room == "A" and player:GetAttribute(ATTR_HAS_SWORD) ~= true then
		print("[PROGRESSION] GolemBaneSword locked - player is in Room A")
		return
	end

	-- Ensure this player has a one-time CharacterAdded restore hook.
	hookPlayerSwordPersistence(player)

	-- Idempotent: already holding a sword → mark owned, do nothing else
	if playerHasSwordInstance(player) then
		player:SetAttribute(ATTR_HAS_SWORD, true)
		print("[ROOM B COMBAT] GolemBaneSword already present — skip duplicate")
		return
	end

	local restoring = player:GetAttribute(ATTR_HAS_SWORD) == true
	player:SetAttribute(ATTR_HAS_SWORD, true)

	if not grantSwordInstance(player) then
		if not restoring then
			player:SetAttribute(ATTR_HAS_SWORD, false)
		end
		return
	end

	if restoring then
		print("[ROOM B COMBAT] GolemBaneSword restored successfully")
		print("[PROGRESSION] Respawn restoration: GolemBaneSword = TRUE")
	else
		print("[PROGRESSION] Room B unlocked GolemBaneSword for " .. player.Name)
		print("[PROGRESSION] GolemBaneSword persistence state = TRUE")
		print("[ROOM B COMBAT] GolemBaneSword granted")
		print("[ROOM B COMBAT] GolemBaneSword placed in Backpack")
		print("[ROOM B COMBAT] GolemBaneSword granted to " .. player.Name)
	end
end

local function ensureSwordAfterRespawn(player)
	if not player then
		return
	end

	if player:GetAttribute(ATTR_HAS_SWORD) ~= true then
		print("[PROGRESSION] Respawn restoration: GolemBaneSword = FALSE")
		return
	end

	print("[PROGRESSION] Respawn restoration: GolemBaneSword = TRUE")

	if playerHasSwordInstance(player) then
		print("[ROOM B COMBAT] GolemBaneSword already present — skip duplicate")
		return
	end

	print("[ROOM B COMBAT] Restoring GolemBaneSword to respawned player")
	rewardSword(player)
end

hookPlayerSwordPersistence = function(player)
	if not player or hookedPlayers[player] then
		return
	end
	hookedPlayers[player] = true

	player.CharacterAdded:Connect(function(_character)
		task.defer(function()
			-- Backpack lives on the Player and can lag slightly after respawn.
			local backpack = player:FindFirstChild("Backpack") or player:WaitForChild("Backpack", 8)
			if not backpack then
				warn("[ROOM B COMBAT] Backpack missing after respawn for " .. player.Name)
				return
			end
			task.wait(0.2)
			if not player.Parent then
				return
			end
			ensureSwordAfterRespawn(player)

			-- One retry for ordering races (Character/Backpack/tools settling).
			task.wait(0.35)
			if player.Parent
				and player:GetAttribute(ATTR_HAS_SWORD) == true
				and not playerHasSwordInstance(player)
			then
				print("[ROOM B COMBAT] Restoring GolemBaneSword to respawned player (retry)")
				rewardSword(player)
			end
		end)
	end)
end

Players.PlayerAdded:Connect(function(player)
	hookPlayerSwordPersistence(player)
end)
Players.PlayerRemoving:Connect(function(player)
	hookedPlayers[player] = nil
end)
for _, player in ipairs(Players:GetPlayers()) do
	hookPlayerSwordPersistence(player)
end

_G.Progression = {
	rewardSword = rewardSword,
	ensureSwordAfterRespawn = ensureSwordAfterRespawn,
	isRoomBSwordRelevant = isRoomBSwordRelevant,
}

return _G.Progression
