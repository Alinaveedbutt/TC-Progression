-- TrialChamberSpellBridge.lua
-- Minimal server-authoritative spell cast for Room C mote weakening.
-- Place as ModuleScript (or Script) under ServerScriptService.
--
-- Designed to be replaced later by the real player spell system:
--   _G.TrialSpell.onSpellHitMote(motePart, player, amount)
--   _G.TrialSpell.castTowardLook(player)
--   _G.TrialSpell.ensureSpellTool(player)

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")

------------------------------------------------------------------------
-- Configurable balance (Room C ~1 minute encounter)
------------------------------------------------------------------------
local CONFIG = {
	TOOL_NAME = "MagicSpell",
	LEGACY_TOOL_NAME = "TrialArcaneFocus",
	SPELL_COOLDOWN = 0.55,
	SPELL_RANGE = 70,
	SPELL_HIT_RADIUS = 5.5,
	SPELL_WEAKNESS = 50, -- attack power 2: two hits to dissolve at 100 max
	VISUAL_COLOR = Color3.fromRGB(180, 230, 255),
	ATTR_HAS_SPELL = "HasTrialArcaneSpell",
}

local castCooldown = {} -- [userId] = os.clock()

local function getEncounter()
	if typeof(_G.RoomCMoteEncounter) == "table" then
		return _G.RoomCMoteEncounter
	end
	local mod = ServerScriptService:FindFirstChild("RoomCMoteEncounter")
	if mod and mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then
			return result
		end
	end
	return nil
end

local function findMoteFromPart(part)
	local current = part
	while current and current ~= Workspace do
		if current:IsA("BasePart") and CollectionService:HasTag(current, "RoomCBlueMote") then
			if current:GetAttribute("Dissolved") ~= true then
				return current
			end
		end
		current = current.Parent
	end
	return nil
end

local function applyWeaknessToMote(mote, player, amount)
	if not mote or not mote.Parent then
		return false
	end
	if mote:GetAttribute("Dissolved") == true then
		return false
	end

	local encounter = getEncounter()
	if encounter and type(encounter.applyMoteSpellHit) == "function" then
		return encounter.applyMoteSpellHit(mote, player, amount)
	end

	-- Fallback if encounter module is unavailable: still kill at 0 HP (no stuck black orbs).
	local maxW = mote:GetAttribute("MaxWeakness") or 100
	local cur = mote:GetAttribute("Weakness") or 0
	local nextW = math.min(maxW, cur + amount)
	mote:SetAttribute("Weakness", nextW)
	local remaining = math.max(0, maxW - nextW)
	if remaining <= 0 then
		mote:SetAttribute("Dissolved", true)
		mote.Transparency = 1
		mote:Destroy()
		print("[ROOM C MOTES] Fallback dissolve (encounter module missing)")
	else
		-- Darken toward black so the player still sees hit feedback
		local ratio = remaining / maxW
		mote.Color = Color3.fromRGB(60, 180, 255):Lerp(Color3.new(0, 0, 0), 1 - ratio)
	end
	warn("[ROOM C MOTES] RoomCMoteEncounter missing — used fallback hit path")
	return true
end

local function spawnCastVisual(origin, targetPos)
	local dist = (targetPos - origin).Magnitude
	if dist < 0.5 then
		return
	end

	-- Short spark burst at the hit point (no laser rod).
	local flash = Instance.new("Part")
	flash.Name = "TrialSpellFlash"
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(0.45, 0.45, 0.45)
	flash.Material = Enum.Material.Neon
	flash.Color = CONFIG.VISUAL_COLOR
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.Transparency = 0.15
	flash.CFrame = CFrame.new(targetPos)
	flash.Parent = Workspace

	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Rate = 0
	sparks.Lifetime = NumberRange.new(0.2, 0.4)
	sparks.Speed = NumberRange.new(3, 8)
	sparks.Size = NumberSequence.new(0.3, 0)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Color = ColorSequence.new(CONFIG.VISUAL_COLOR)
	sparks.LightEmission = 1
	sparks.Parent = flash
	sparks:Emit(12)

	local light = Instance.new("PointLight")
	light.Color = CONFIG.VISUAL_COLOR
	light.Brightness = 1.8
	light.Range = 8
	light.Parent = flash

	Debris:AddItem(flash, 0.35)
	TweenService:Create(flash, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(1.4, 1.4, 1.4),
		Transparency = 1,
	}):Play()
end

local function castTowardLook(player)
	if not player then
		return false
	end

	if player:GetAttribute(CONFIG.ATTR_HAS_SPELL) ~= true then
		return false
	end

	local now = os.clock()
	local last = castCooldown[player.UserId]
	if last and (now - last) < CONFIG.SPELL_COOLDOWN then
		return false
	end

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then
		return false
	end

	castCooldown[player.UserId] = now

	local origin = hrp.Position + Vector3.new(0, 1.5, 0)
	local look = hrp.CFrame.LookVector
	local endPos = origin + look * CONFIG.SPELL_RANGE

	-- Sample along look ray for mote hits (server authoritative, dodge-friendly aim)
	local hitMote = nil
	local hitPos = endPos
	local steps = 14
	for i = 1, steps do
		local t = i / steps
		local sample = origin:Lerp(endPos, t)
		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Exclude
		overlap.FilterDescendantsInstances = { character }
		local parts = Workspace:GetPartBoundsInRadius(sample, CONFIG.SPELL_HIT_RADIUS, overlap)
		for _, part in ipairs(parts) do
			local mote = findMoteFromPart(part)
			if mote then
				hitMote = mote
				hitPos = mote.Position
				break
			end
		end
		if hitMote then
			break
		end
	end

	spawnCastVisual(origin, hitPos)

	if hitMote then
		return applyWeaknessToMote(hitMote, player, CONFIG.SPELL_WEAKNESS)
	end

	return false
end

local function bindSpellTool(tool, player)
	tool.Activated:Connect(function()
		castTowardLook(player)
	end)
end

local function findNamedTool(player, name)
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		local tool = backpack:FindFirstChild(name)
		if tool then
			return tool
		end
	end
	local character = player.Character
	if character then
		return character:FindFirstChild(name)
	end
	return nil
end

local function findSpellTool(player)
	if not player then
		return nil
	end
	local tool = findNamedTool(player, CONFIG.TOOL_NAME)
		or findNamedTool(player, CONFIG.LEGACY_TOOL_NAME)
	if tool and tool.Name ~= CONFIG.TOOL_NAME then
		tool.Name = CONFIG.TOOL_NAME
	end
	return tool
end

local function playerHasSpellTool(player)
	return findSpellTool(player) ~= nil
end

local SWORD_NAME = "GolemBaneSword"

local function orderHotbar(player)
	if not player then
		return
	end
	local backpack = player:FindFirstChild("Backpack")
	local character = player.Character
	if not backpack then
		return
	end

	local function findTool(name)
		if backpack:FindFirstChild(name) then
			return backpack:FindFirstChild(name)
		end
		if character then
			return character:FindFirstChild(name)
		end
		return nil
	end

	local sword = findTool(SWORD_NAME)
	local spell = findTool(CONFIG.TOOL_NAME) or findTool(CONFIG.LEGACY_TOOL_NAME)
	if spell and spell.Name ~= CONFIG.TOOL_NAME then
		spell.Name = CONFIG.TOOL_NAME
	end
	if not sword and not spell then
		return
	end

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:UnequipTools()
	end

	-- Slot 1 = GolemBaneSword, slot 2 = MagicSpell.
	if sword then
		sword.Parent = nil
		sword.Parent = backpack
	end
	if spell then
		spell.Parent = nil
		spell.Parent = backpack
	end
end

local hotbarOrdered = {}

local function ensureSpellTool(player)
	if not player then
		return nil
	end
	if player:GetAttribute(CONFIG.ATTR_HAS_SPELL) ~= true then
		return nil
	end

	if playerHasSpellTool(player) then
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = CONFIG.TOOL_NAME
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "Magic Spell — weaken Room C motes"

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 1.2)
	handle.Material = Enum.Material.Neon
	handle.Color = CONFIG.VISUAL_COLOR
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local tip = Instance.new("Part")
	tip.Name = "FocusCrystal"
	tip.Shape = Enum.PartType.Ball
	tip.Size = Vector3.new(0.7, 0.7, 0.7)
	tip.Material = Enum.Material.Neon
	tip.Color = Color3.fromRGB(120, 210, 255)
	tip.CanCollide = false
	tip.Massless = true
	tip.Parent = tool

	local weld = Instance.new("Weld")
	weld.Part0 = handle
	weld.Part1 = tip
	weld.C0 = CFrame.new(0, 0, -0.85)
	weld.Parent = handle

	local light = Instance.new("PointLight")
	light.Color = CONFIG.VISUAL_COLOR
	light.Brightness = 1.5
	light.Range = 10
	light.Parent = tip

	bindSpellTool(tool, player)

	local backpack = player:FindFirstChild("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack then
		tool:Destroy()
		return nil
	end

	tool.Parent = backpack
	print("[ROOM C] MagicSpell granted to " .. player.Name)
	orderHotbar(player)
	return tool
end

local function unlockSpell(player)
	if not player then
		return nil
	end
	if player:GetAttribute(CONFIG.ATTR_HAS_SPELL) == true and playerHasSpellTool(player) then
		return nil
	end

	player:SetAttribute(CONFIG.ATTR_HAS_SPELL, true)
	print("[PROGRESSION] Spell unlocked for " .. player.Name)
	print("[PROGRESSION] Spell persistence state = TRUE")
	return ensureSpellTool(player)
end

local function restoreSpellAfterRespawn(player)
	if player:GetAttribute(CONFIG.ATTR_HAS_SPELL) ~= true then
		print("[PROGRESSION] Respawn restoration: Spell = FALSE")
		return
	end
	print("[PROGRESSION] Respawn restoration: Spell = TRUE")
	ensureSpellTool(player)
	orderHotbar(player)
end

local hookedSpellPlayers = {}

local function hookPlayerSpellPersistence(player)
	if not player or hookedSpellPlayers[player] then
		return
	end
	hookedSpellPlayers[player] = true

	player.CharacterAdded:Connect(function(_character)
		hotbarOrdered[player.UserId] = nil
		task.defer(function()
			local backpack = player:FindFirstChild("Backpack") or player:WaitForChild("Backpack", 8)
			if not backpack then
				return
			end
			task.wait(0.2)
			if player.Parent then
				restoreSpellAfterRespawn(player)
			end
			task.wait(0.35)
			if player.Parent
				and player:GetAttribute(CONFIG.ATTR_HAS_SPELL) == true
				and not playerHasSpellTool(player)
			then
				ensureSpellTool(player)
			end
		end)
	end)
end

Players.PlayerAdded:Connect(function(player)
	hookPlayerSpellPersistence(player)
end)
Players.PlayerRemoving:Connect(function(player)
	castCooldown[player.UserId] = nil
	hotbarOrdered[player.UserId] = nil
	hookedSpellPlayers[player] = nil
end)
for _, player in ipairs(Players:GetPlayers()) do
	hookPlayerSpellPersistence(player)
end

-- Grant MagicSpell the moment the player crosses into Room C (doorway),
-- not after walking to the Heart. Slot 1 sword / slot 2 spell.
local ROOM_C_ENTRY_LOCAL_Z = 425
local grantAcc = 0
RunService.Heartbeat:Connect(function(dt)
	grantAcc += dt
	if grantAcc < 0.2 then
		return
	end
	grantAcc = 0

	local root = Workspace:FindFirstChild("TrialChamberGeneratedV5_Sky")
		or Workspace:FindFirstChild("TrialChamberActive")
		or Workspace:FindFirstChild("TrialChamberV2")
	if not root then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local z = root:GetPivot():PointToObjectSpace(hrp.Position).Z
			if z >= ROOM_C_ENTRY_LOCAL_Z then
				unlockSpell(player)
				if not hotbarOrdered[player.UserId] then
					hotbarOrdered[player.UserId] = true
					orderHotbar(player)
				end
			end
		end
	end
end)

local API = {
	CONFIG = CONFIG,
	castTowardLook = castTowardLook,
	unlockSpell = unlockSpell,
	ensureSpellTool = ensureSpellTool,
	restoreSpellAfterRespawn = restoreSpellAfterRespawn,
	orderHotbar = orderHotbar,
	applyWeaknessToMote = applyWeaknessToMote,
	onSpellHitMote = applyWeaknessToMote, -- alias for future real spell system
}

_G.TrialSpell = API

print("[TRIAL SPELL] TrialChamberSpellBridge ready")

return API
